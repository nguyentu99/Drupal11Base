<?php

  /**
   * @file
   * Functions to support theming in the cassiopeia_admin_theme theme.
   */

  use Drupal\Component\Utility\Html;
  use Drupal\Core\Cache\CacheableMetadata;
  use Drupal\Core\Render\Element;
  use Drupal\user\Entity\User;

  /**
   * Implements hook_preprocess_HOOK() for HTML document templates.
   */
  function cassiopeia_admin_theme_preprocess_html(&$variables): void {
    $classes = ['layout-fixed', 'sidebar-expand-lg', 'bg-body-tertiary'];
    if (isset($variables['attributes']['class'])) {
      $variables['attributes']['class'] = array_merge($variables['attributes']['class'], $classes);
    }
    else {
      $variables['attributes']['class'] = $classes;
    }
  }

  /**
   * Implements hook_page_attachments_alter().
   */
  function cassiopeia_admin_theme_page_attachments_alter(array &$attachments): void {
    if (empty($attachments['#attached']['library'])) {
      return;
    }
    $attachments['#attached']['library'] = array_values(array_filter(
      $attachments['#attached']['library'],
      static fn (string $library): bool => $library !== 'bootstrap/bootstrap-icons',
    ));
  }

  /**
   * Implements hook_preprocess_HOOK() for page templates.
   */
  function cassiopeia_admin_theme_preprocess_page(&$variables): void {
    if (\Drupal::moduleHandler()->moduleExists('cassiopeia_admin')) {
      $variables['administrator_menu'] = \Drupal::service('cassiopeia_admin.administrator')
        ->cassiopeia_admin_get_administrator_menu();
    }

    $route_name = \Drupal::routeMatch()->getRouteName();
    if ($route_name) {
      $local_task_manager = \Drupal::service('plugin.manager.menu.local_task');
      $cacheability = new CacheableMetadata();

      $primary = $local_task_manager->getLocalTasks($route_name, 0);
      $cacheability = $cacheability->merge($primary['cacheability']);
      $secondary = $local_task_manager->getLocalTasks($route_name, 1);
      $cacheability = $cacheability->merge($secondary['cacheability']);

      $primary_tabs = $primary['tabs'] ?? [];
      $secondary_tabs = $secondary['tabs'] ?? [];
      $visible_primary = array_intersect_key(
        $primary_tabs,
        array_flip(Element::getVisibleChildren($primary_tabs)),
      );
      $visible_secondary = array_intersect_key(
        $secondary_tabs,
        array_flip(Element::getVisibleChildren($secondary_tabs)),
      );

      if ($visible_primary !== [] || $visible_secondary !== []) {
        $variables['admin_local_tasks'] = [
          '#theme' => 'menu_local_tasks',
          '#primary' => $visible_primary,
          '#secondary' => $visible_secondary,
        ];
        $cacheability->applyTo($variables);
      }
    }

    $uid = (int) \Drupal::currentUser()->id();
    if ($uid <= 0) {
      return;
    }
    $account = User::load($uid);
    if (!$account) {
      return;
    }
    $variables['account'] = $account;
    $variables['account_avatar_header'] = cassiopeia_admin_theme_build_user_avatar($account, [
      'user-image',
      'rounded-circle',
      'shadow',
    ]);
    $variables['account_avatar_sidebar'] = cassiopeia_admin_theme_build_user_avatar($account, [
      'img-fluid',
      'rounded-circle',
      'sidebar-user-panel__image',
    ]);

    $site_config = \Drupal::config('system.site');
    $variables['site_name'] = $site_config->get('name') ?: 'CNC Industrial';
    $variables['site_logo'] = '/' . \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme') . '/images/cnc-logo.png';
    $variables['front_url'] = \Drupal\Core\Url::fromRoute('<front>')->toString();
  }

  /**
   * Builds a single image_style render array for a user account.
   */
  function cassiopeia_admin_theme_build_user_avatar(User $account, array $classes): array {
    /** @var \Drupal\cassiopeia\Service\CassiopeiaImageBuilder $image_builder */
    $image_builder = \Drupal::service('cassiopeia.image_builder');

    $fid = NULL;
    $picture = $account->get('user_picture');
    if (!$picture->isEmpty() && $picture->entity) {
      $fid = $picture->target_id;
    }

    $build = $image_builder->buildRenderArray('style_200x200', $fid, 'public://default.png', [
      'class' => $classes,
      'alt' => t('User picture'),
    ]);

    if ($build === NULL) {
      return [];
    }

    $build['#cache']['tags'] = $account->getCacheTags();
    $build['#cache']['contexts'] = ['user'];

    return $build;
  }

  /**
   * Implements hook_preprocess_HOOK() for menu-local-action.html.twig.
   */
  function cassiopeia_admin_theme_preprocess_menu_local_action(&$variables): void {
    $variables['link']['#options']['attributes']['class'][] = 'btn-sm';
  }

  /**
   * Implements hook_theme_suggestions_HOOK_alter() for status_messages.
   */
  function cassiopeia_admin_theme_theme_suggestions_status_messages_alter(array &$suggestions, array $variables): void {
    $suggestions[] = 'status_messages__toasts';
  }

  /**
   * Implements hook_preprocess_HOOK() for status_messages.
   */
  function cassiopeia_admin_theme_preprocess_status_messages(array &$variables): void {
    $variables['toast_delay'] = 8000;
    $variables['title_ids'] = [];
    if (!is_array($variables['message_list'])) {
      return;
    }
    foreach (array_keys($variables['message_list']) as $message_type) {
      $variables['title_ids'][$message_type] = Html::getUniqueId("message-$message_type-title");
    }
  }
