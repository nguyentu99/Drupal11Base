<nav class="app-header navbar navbar-expand cassiopeia-admin-navbar">
  <div class="container-fluid">
    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="{{ 'Toggle sidebar'|t }}">
          <i class="fa-solid fa-bars"></i>
        </a>
      </li>
    </ul>
    <ul class="navbar-nav ms-auto">
      <li class="nav-item dropdown user-menu">
        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
          {% if account_avatar %}
            <span class="user-menu__avatar">{{ account_avatar }}</span>
          {% endif %}
          <span class="d-none d-md-inline">{{ account.getAccountName() }}</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
          <li class="user-header text-bg-primary">
            {% if account_avatar %}
              {{ account_avatar }}
            {% endif %}
            <p>
              {{ account.getEmail() }}
              <small>
                {{ 'Member since @date'|t({'@date': account.getCreatedTime()|date('d/m/Y')}) }}
              </small>
            </p>
          </li>
          <li class="user-footer">
            <a href="/user/{{ account.id() }}/edit" class="btn btn-default btn-flat">{{ 'Profile'|t }}</a>
            <a href="/user/logout" class="btn btn-default btn-flat float-end">{{ 'Sign out'|t }}</a>
          </li>
        </ul>
      </li>
    </ul>
  </div>
</nav>
