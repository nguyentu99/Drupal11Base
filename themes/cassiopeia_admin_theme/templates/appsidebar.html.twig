<aside class="app-sidebar sidebar-dark-primary elevation-4" data-bs-theme="dark">
  <div class="sidebar-brand">
    <a href="{{ front_url|default('/') }}" class="brand-link">
      <span class="brand-text fw-light">{{ site_name|default('CNC Industrial') }}</span>
    </a>
  </div>
  <div class="sidebar-wrapper">
    {% if account %}
      <div class="sidebar-user-panel">
        <div class="sidebar-user-panel__avatar">
          {% if account_avatar %}
            {{ account_avatar }}
          {% else %}
            <img src="/themes/cassiopeia_theme/images/default.png" alt="" class="sidebar-user-panel__image rounded-circle">
          {% endif %}
        </div>
        <div class="sidebar-user-panel__info">
          <a href="/user/{{ account.id() }}/edit" class="sidebar-user-panel__name">{{ account.getAccountName() }}</a>
          <span class="sidebar-user-panel__status">{{ 'Online'|t }}</span>
        </div>
      </div>
    {% endif %}
    <nav>
      {{ administrator_menu }}
    </nav>
  </div>
</aside>
