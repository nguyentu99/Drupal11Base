<?php

/**
 * @file
 * Functions to support theming in the cassiopeia_theme theme.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_preprocess_HOOK() for HTML document templates.
 */
function cassiopeia_theme_preprocess_html(array &$variables): void {
  if (!empty($variables['is_front'])) {
    $variables['attributes']['class'][] = 'path-frontpage';
  }
  if (\Drupal::routeMatch()->getRouteName() === 'user.login') {
    $variables['attributes']['class'][] = 'path-user-login';
  }
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function cassiopeia_theme_preprocess_page(array &$variables): void {
  // Static homepage markup — do not render Drupal frontpage view in content.
  if (!empty($variables['is_front'])) {
    $variables['page']['content'] = [];
  }

  if (\Drupal::routeMatch()->getRouteName() === 'user.login') {
    $language = \Drupal::languageManager()->getCurrentLanguage();
    $theme_path = \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');
    $variables['#attached']['library'][] = 'cassiopeia_theme/login-page';
    $variables['login_page'] = [
      'hero_image' => '/' . $theme_path . '/images/services/operations/hero-banner.jpg',
      'hero_title' => (string) t('Đăng nhập'),
      'hero_lead' => (string) t('Truy cập khu vực quản trị nội dung CNC Industrial.'),
      'panel_title' => (string) t('Đăng nhập tài khoản'),
      'panel_lead' => (string) t('Nhập thông tin đăng nhập để tiếp tục.'),
      'forgot_password_url' => Url::fromRoute('user.pass', [], ['language' => $language])->toString(),
      'home_url' => Url::fromRoute('<front>', [], ['language' => $language])->toString(),
    ];
  }

  // Header menu + language switcher cache metadata.
  $variables['#cache']['contexts'] = Cache::mergeContexts($variables['#cache']['contexts'] ?? [], [
    'languages:language_interface',
    'languages:language_content',
    'route.menu_active_trails:main',
    'url.path',
    'url.query_args',
    'url.site',
  ]);
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], [
    'config:system.menu.main',
    'config:configurable_language_list',
    'config:language.negotiation',
  ]);
}

/**
 * Implements hook_form_FORM_ID_alter() for user login.
 */
function cassiopeia_theme_form_user_login_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $form['#attributes']['class'][] = 'login-form';

  foreach (['name', 'pass'] as $field_name) {
    if (!isset($form[$field_name])) {
      continue;
    }
    $form[$field_name]['#attributes']['class'][] = 'form-control';
    $form[$field_name]['#attributes']['class'][] = 'login-form__input';
    $form[$field_name]['#wrapper_attributes']['class'][] = 'login-form__field';
    $form[$field_name]['#label_attributes']['class'][] = 'form-label';
  }

  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#attributes']['class'] = ['login-form__submit'];
    $form['actions']['#attributes']['class'][] = 'login-form__actions';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for input elements.
 */
function cassiopeia_theme_theme_suggestions_input_alter(array &$suggestions, array $variables): void {
  $element = $variables['element'];
  if (($element['#type'] ?? '') !== 'submit') {
    return;
  }
  $classes = $element['#attributes']['class'] ?? [];
  if (in_array('login-form__submit', $classes, TRUE)) {
    array_unshift($suggestions, 'input__submit__login_form__submit');
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for status_messages.
 */
function cassiopeia_theme_theme_suggestions_status_messages_alter(array &$suggestions, array $variables): void {
  $suggestions[] = 'status_messages__toasts';
}

/**
 * Implements hook_preprocess_HOOK() for status_messages.
 */
function cassiopeia_theme_preprocess_status_messages(array &$variables): void {
  $variables['toast_delay'] = 8000;
  $variables['title_ids'] = [];
  if (!is_array($variables['message_list'])) {
    return;
  }
  foreach (array_keys($variables['message_list']) as $message_type) {
    $variables['title_ids'][$message_type] = Html::getUniqueId("message-$message_type-title");
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function cassiopeia_theme_preprocess_node(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  $node = $variables['node'];
  if ($node->getType() === 'article') {
    $variables['article'] = cassiopeia_article_detail_variables($node);
  }
  if ($node->getType() === 'market_research') {
    $variables['market_research'] = cassiopeia_market_research_detail_variables($node);
    $variables['#cache']['tags'][] = 'node_list:market_research';
    $variables['#cache']['tags'][] = 'node_list:banner';
  }
  if ($node->getType() === 'investment_handbook') {
    $variables['handbook'] = cassiopeia_investment_handbook_detail_variables($node);
    $variables['#cache']['tags'][] = 'node_list:investment_handbook';
    $variables['#cache']['tags'][] = 'node_list:banner';
  }
  if ($node->getType() === 'active_network') {
    $variables['active_network'] = cassiopeia_active_network_detail_variables($node);
    $variables['#attached']['library'][] = 'cassiopeia_theme/network-page';
    $variables['#cache']['tags'][] = 'node_list:active_network';
    $variables['#cache']['tags'][] = 'node_list:banner';
    $variables['#cache']['tags'][] = 'node:' . $node->id();
  }
  if ($node->getType() === 'partner') {
    $variables['partner'] = cassiopeia_partner_detail_variables($node);
    $variables['#attached']['library'][] = 'cassiopeia_theme/partner-video';
    $variables['#cache']['tags'][] = 'node_list:partner';
    $variables['#cache']['tags'][] = 'node_list:banner';
    $variables['#cache']['tags'][] = 'node:' . $node->id();
  }
  if ($node->getType() === 'projects') {
    $variables['project'] = cassiopeia_projects_detail_variables($node);
    $variables['project']['contact_form'] = \Drupal::formBuilder()->getForm('Drupal\cassiopeia\Form\ContactForm');
    $variables['#cache']['tags'][] = 'node_list:projects';
    $variables['#cache']['tags'][] = 'node_list:banner';
    $variables['#cache']['tags'][] = 'node:' . $node->id();
    $variables['#cache']['contexts'][] = 'user';
  }
  if ($node->getType() === 'dich_vu') {
    $variables['service'] = cassiopeia_dich_vu_detail_variables($node);
    $variables['service']['contact_form'] = \Drupal::formBuilder()->getForm('Drupal\cassiopeia\Form\ContactForm');
    $variables['#cache']['tags'][] = 'node_list:dich_vu';
    $variables['#cache']['tags'][] = 'node_list:banner';
    $variables['#cache']['tags'][] = 'node_list:projects';
    $variables['#cache']['tags'][] = 'node:' . $node->id();
    $variables['#cache']['contexts'][] = 'user';
  }
}

/**
 * Implements hook_preprocess_HOOK() for taxonomy term templates.
 */
function cassiopeia_theme_preprocess_taxonomy_term(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  $term = $variables['term'] ?? NULL;
  if (!$term instanceof TermInterface || $term->bundle() !== 'tx_article') {
    return;
  }
  $variables['news_page'] = cassiopeia_news_page_variables($term);
  $variables['#cache']['contexts'] = [
    'url.query_args:q',
    'url.query_args:page',
    'languages:language_interface',
    'languages:language_content',
  ];
  $variables['#cache']['tags'] = [
    'node_list:article',
    'node_list:banner',
    'taxonomy_term_list:tx_article',
    'taxonomy_term:' . $term->id(),
  ];
}
