<?php

/**
 * @file
 * Functions to support theming in the cassiopeia_theme theme.
 */

use Drupal\Component\Utility\Html;

/**
 * Implements hook_preprocess_HOOK() for HTML document templates.
 */
function cassiopeia_theme_preprocess_html(array &$variables): void {
  if (!empty($variables['is_front'])) {
    $variables['attributes']['class'][] = 'path-frontpage';
  }
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function cassiopeia_theme_preprocess_page(array &$variables): void {
  // Static homepage markup — do not render Drupal frontpage view in content.
  if (!empty($variables['is_front'])) {
    $variables['page']['content'] = [];
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for status_messages.
 */
function cassiopeia_theme_theme_suggestions_status_messages_alter(array &$suggestions, array $variables): void {
  $suggestions[] = 'status_messages__toasts';
}

/**
 * Implements hook_preprocess_HOOK() for status_messages.
 */
function cassiopeia_theme_preprocess_status_messages(array &$variables): void {
  $variables['toast_delay'] = 8000;
  $variables['title_ids'] = [];
  if (!is_array($variables['message_list'])) {
    return;
  }
  foreach (array_keys($variables['message_list']) as $message_type) {
    $variables['title_ids'][$message_type] = Html::getUniqueId("message-$message_type-title");
  }
}
