{{ include('@cassiopeia_theme/templates/header.html.twig') }}
<div class="site-status-messages">{{ page.status_messages }}</div>
<main id="main-content" class="site-main">
  {% if page.breadcrumb %}
    <div class="container py-3">
      {{ page.breadcrumb }}
    </div>
  {% endif %}
  {% if page.highlighted %}
    <div class="container">
      {{ page.highlighted }}
    </div>
  {% endif %}
  <div class="container py-4">
    {{ page.content }}
  </div>
</main>
{{ include('@cassiopeia_theme/templates/footer.html.twig') }}
