{#
/** Homepage section from html/index.html */
#}
{% set strip = site_config.contact_strip %}
<footer class="site-footer">
        <div class="site-footer__topbar">
            <div class="container">
                <div class="contact-strip">
                    <div class="contact-strip__left">
                        {% if strip.phone %}
                        <div class="contact-strip__item">
                            <img width="32" height="32" class="contact-strip__icon"
                                src="/themes/cassiopeia_theme/images/contact-strip/phone-red.svg" alt="">
                            <div class="contact-strip__text">
                                <span class="contact-strip__label">{{ strip.phone_label }}</span>
                                <a class="contact-strip__value" href="tel:{{ strip.phone_link }}">{{ strip.phone }}</a>
                            </div>
                        </div>
                        {% endif %}
                        {% if strip.phone and strip.email %}
                        <span class="contact-strip__divider" aria-hidden="true"></span>
                        {% endif %}
                        {% if strip.email %}
                        <div class="contact-strip__item">
                            <img width="32" height="32" class="contact-strip__icon"
                                src="/themes/cassiopeia_theme/images/contact-strip/map-red.svg" alt="">
                            <div class="contact-strip__text">
                                <span class="contact-strip__label">{{ strip.email_label }}</span>
                                <a class="contact-strip__value" href="mailto:{{ strip.email }}">{{ strip.email }}</a>
                            </div>
                        </div>
                        {% endif %}
                        {% if strip.email and (strip.facebook_url or strip.youtube_url or strip.linkedin_url) %}
                        <span class="contact-strip__divider" aria-hidden="true"></span>
                        {% endif %}
                        {% if strip.facebook_url or strip.youtube_url or strip.linkedin_url %}
                        <div class="contact-strip__social-block">
                            <span class="contact-strip__label">{{ strip.social_label }}</span>
                            <div class="contact-strip__social">
                                {% if strip.facebook_url %}
                                <a href="{{ strip.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><img width="36" height="36"
                                        src="/themes/cassiopeia_theme/images/contact-strip/facebook-logo.svg" alt=""></a>
                                {% endif %}
                                {% if strip.youtube_url %}
                                <a href="{{ strip.youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><img width="36" height="36"
                                        src="/themes/cassiopeia_theme/images/contact-strip/youtube.svg" alt=""></a>
                                {% endif %}
                                {% if strip.linkedin_url %}
                                <a href="{{ strip.linkedin_url }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><img width="36" height="36"
                                        src="/themes/cassiopeia_theme/images/contact-strip/in-logo.svg" alt=""></a>
                                {% endif %}
                            </div>
                        </div>
                        {% endif %}
                    </div>
                    {% if strip.address %}
                    <a class="contact-strip__map" href="{{ strip.map_url ?: '#' }}"{% if strip.map_url %} target="_blank" rel="noopener noreferrer"{% endif %}>
                        <img width="32" height="32" class="contact-strip__icon" src="/themes/cassiopeia_theme/images/contact-strip/map-red.svg"
                            alt="">
                        <div class="contact-strip__text">
                            <span class="contact-strip__label">{{ strip.map_label }}</span>
                            <p class="contact-strip__value">{{ strip.address|nl2br }}</p>
                        </div>
                        <img width="40" height="40" class="contact-strip__chevron"
                            src="/themes/cassiopeia_theme/images/contact-strip/chevron.svg" alt="">
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="site-footer__main">
            <div class="container">
                <div class="row align-items-start justify-content-between g-4 mb-4 pb-4 border-bottom">
                    <div class="col-md-6 col-lg-5 d-flex flex-column align-items-start">
                        <a class="site-footer__logo d-inline-block" href="{{ front_page }}">
                            <img width="313" height="54" src="/themes/cassiopeia_theme/images/cnc-logo.png" alt="CNC Industrial">
                        </a>
                        <a class="site-footer__download d-inline-flex mt-3" href="{{ base_path }}#">
                            Tải hồ sơ năng lực
                            <i class="fa-regular fa-download" aria-hidden="true"></i>
                        </a>
                    </div>
                    <div class="col-md-6 col-lg-auto text-md-end">
                        <div class="site-footer__brand-right d-inline-flex flex-column align-items-md-end gap-3">
                            <p class="site-footer__group-label mb-0">một thành viên của CNCTech Group</p>
                            <img width="186" height="48" class="site-footer__group-logo" src="/themes/cassiopeia_theme/images/logo-red.png"
                                alt="CNCTech Group">
                        </div>
                    </div>
                </div>
                {{ cassiopeia_menu('main', 1, 0, true, 'menu__main__footer') }}
                <div class="row align-items-center justify-content-between g-3">
                    <div class="col-md">
                        <p class="site-footer__copy mb-0">Copyright © 2026 CNC Industrial. All rights reserved.</p>
                    </div>
                    <div class="col-md-auto">
                        <a class="site-footer__privacy" href="{{ base_path }}#">Chính sách bảo mật</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
