{#
/**
 * @file
 * Themed 403/404 error pages.
 */
#}
{{ include('@cassiopeia_theme/templates/header.html.twig') }}
<div class="site-status-messages">{{ page.status_messages }}</div>

<main id="main-content" class="error-page error-page--{{ error_page.tone }}">
  <div class="container">
    {# <nav class="error-page__breadcrumb" aria-label="{{ 'Breadcrumb'|t }}">
      <ol class="breadcrumb error-page__breadcrumb-list">
        <li class="breadcrumb-item"><a href="{{ error_page.home_url }}">{{ 'Home'|t }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ error_page.breadcrumb_label }}</li>
      </ol>
    </nav> #}

    <div class="error-page__panel">
      <div class="error-page__visual" aria-hidden="true">
        <span class="error-page__code">{{ error_page.code }}</span>
      </div>

      <div class="error-page__brand">
        <img class="error-page__logo" src="/themes/cassiopeia_theme/images/cnc-logo.png" alt="CNC Industrial" width="232" height="40">
      </div>

      <div class="error-page__content">
        <h1 class="error-page__title">{{ error_page.title }}</h1>
        <p class="error-page__message">{{ error_page.message }}</p>
      </div>

      <div class="error-page__actions">
        <a class="btn-see-more btn-see-more--solid error-page__action" href="{{ error_page.home_url }}">
          {{ 'Back to home'|t }}
          <span class="btn-see-more__icon btn-see-more__icon--sm"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        {% if error_page.show_login %}
          <a class="btn-see-more error-page__action error-page__action--secondary" href="{{ error_page.login_url }}">
            {{ 'Log in'|t }}
            <span class="btn-see-more__icon btn-see-more__icon--sm"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
          </a>
        {% endif %}
        <a class="error-page__link" href="{{ error_page.contact_url }}">{{ 'Contact support'|t }}</a>
      </div>
    </div>
  </div>
</main>

{# {{ include('@cassiopeia_theme/templates/footer.html.twig') }} #}
