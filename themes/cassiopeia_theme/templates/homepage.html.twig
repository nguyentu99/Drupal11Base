{#
/** Homepage section from html/index.html */
#}
<div class="hero">
        <img width="1920" height="880" class="hero__media" src="{{ homepage.hero.image }}" alt="{{ homepage.hero.alt }}">
        <div class="hero__curve"></div>
    </div>

    {% if homepage.about %}
    <div class="section about-stats">
        <div class="container">
            <div class="row g-4 g-lg-5 align-items-start">
                <div class="col-lg-7">
                    {% if homepage.about.title %}
                    <h2 class="t-heading-1 mb-4">{{ homepage.about.title }}</h2>
                    {% endif %}
                    {% if homepage.about.lead_html %}
                    <div class="t-body text-justify mb-4 mb-lg-5">{{ homepage.about.lead_html|raw }}</div>
                    {% endif %}
                    {% if homepage.about.stats is not empty %}
                    <div class="row g-3 g-md-4">
                        {% for stat in homepage.about.stats %}
                        <div class="col-md-4 col-6">
                            <div class="stat-card">
                                <div class="stat-card__value">
                                    <span class="stat-card__num" data-count="{{ stat.value }}">0</span>
                                    {% if stat.unit %}<span>{{ stat.unit }}</span>{% endif %}
                                </div>
                                <p class="stat-card__label">{{ stat.label|raw }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
                {% if homepage.about.map %}
                <div class="col-lg-5 about-stats__map">
                    <div class="vn-map">
                        <img width="516" height="620" class="vn-map__base" src="{{ homepage.about.map.image }}"
                            alt="{{ homepage.about.map.alt }}">
                        {% for spot in homepage.about.map.spots %}
                        <div class="vn-map__spot vn-map__spot--{{ spot.key }}">
                            {{ spot.connector|raw }}
                            <span class="vn-map__pin"><img width="16" height="20" src="/themes/cassiopeia_theme/images/svg/location.svg" alt=""></span>
                            <span class="vn-map__label{{ spot.accent ? ' vn-map__label--accent' : '' }}">
                                <span class="vn-map__label-name">{{ spot.name }}</span><span class="vn-map__label-sep">:</span>
                                <span class="vn-map__label-value">{{ spot.value }}</span>
                            </span>
                        </div>
                        {% endfor %}
                        {% if homepage.about.map.hoang_sa_label %}
                        <span class="vn-map__island-label vn-map__island-label--hoang-sa">{{ homepage.about.map.hoang_sa_label|nl2br }}</span>
                        {% endif %}
                        {% if homepage.about.map.truong_sa_label %}
                        <span class="vn-map__island-label vn-map__island-label--truong-sa">{{ homepage.about.map.truong_sa_label|nl2br }}</span>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {% if homepage.services is not empty %}
    <div class="section section--gray section--services" id="dich-vu">
        <div class="container">
            <div class="section__head section__head--split">
                {% if homepage.services_heading is defined and homepage.services_heading.title %}
                <h2 class="t-heading-1">{{ homepage.services_heading.title }}</h2>
                {% endif %}
                {% if homepage.services_heading is defined and homepage.services_heading.lead %}
                <p class="t-body">{{ homepage.services_heading.lead }}</p>
                {% endif %}
            </div>
        </div>
        <div class="services-showcase">
            <div class="services-showcase__slide" data-default-bg="{{ homepage.services_default_bg }}">
                <div class="services-showcase__bgs">
                    <img width="1920" height="768" class="services-showcase__bg is-visible" src="{{ homepage.services_default_bg }}"
                        alt="">
                    <img width="1920" height="768" class="services-showcase__bg" alt="">
                </div>
                <div class="services-showcase__labels">
                    {% for service in homepage.services %}
                    <article class="services-showcase__label" tabindex="0" data-bg="{{ service.bg }}">
                        <h3 class="services-showcase__label-title">{{ service.title_html|raw }}</h3>
                        <div class="services-showcase__label-body">
                            <p class="services-showcase__label-desc">{{ service.description }}</p>
                            <span class="services-showcase__label-rule"></span>
                            <a class="btn-see-more" href="{{ service.url }}">xem thêm<span
                                    class="btn-see-more__icon"><i class="fa-solid fa-arrow-right"></i></span></a>
                        </div>
                    </article>
                    {% endfor %}
                </div>
            </div>
            <div class="services-showcase__nav">
                <button type="button" class="services-showcase__nav-btn services-showcase__nav-btn--prev is-disabled"
                    aria-label="Dịch vụ trước">
                    <img width="48" height="48" src="/themes/cassiopeia_theme/images/svg/services-arrow-left.svg" alt="">
                </button>
                <button type="button" class="services-showcase__nav-btn services-showcase__nav-btn--next"
                    aria-label="Dịch vụ tiếp theo">
                    <img width="48" height="48" src="/themes/cassiopeia_theme/images/svg/services-arrow-left.svg" alt="">
                </button>
            </div>
        </div>
    </div>
    {% endif %}

    {% if homepage.projects.featured %}
    <div class="section">
        <div class="container">
            <div class="section__head section__head--split">
                {% if homepage.projects_heading is defined and homepage.projects_heading.title %}
                <h2 class="t-heading-1">{{ homepage.projects_heading.title|nl2br }}</h2>
                {% endif %}
                {% if homepage.projects_heading is defined and homepage.projects_heading.lead %}
                <p class="t-body">{{ homepage.projects_heading.lead }}</p>
                {% endif %}
            </div>
        </div>
        {% set featured = homepage.projects.featured %}
        <article class="project-featured">
            <img width="1920" height="596" class="project-featured__img" src="{{ featured.image }}"
                alt="{{ featured.image_alt }}">
            <div class="project-featured__panel">
                <div class="project-featured__info">
                    <h3 class="project-featured__title">{{ featured.title_html|default(featured.title)|raw }}</h3>
                    <p class="project-featured__loc">
                        <img width="20" height="20" class="project-featured__loc-icon"
                            src="{{ featured.location_icon }}" alt="">
                        {{ featured.address }}
                    </p>
                </div>
                <a class="btn-see-more" href="{{ featured.url }}">xem thêm<span
                        class="btn-see-more__icon"><i class="fa-solid fa-arrow-right"></i></span></a>
            </div>
        </article>
        <div class="container">
            <div class="project-carousel owl-carousel">
                {% for project in homepage.projects.cards %}
                <article class="project-card">
                    <a class="project-card__link" href="{{ project.url }}">
                        <img width="420" height="293" class="project-card__img" src="{{ project.image }}"
                            alt="{{ project.image_alt }}">
                        <div class="project-card__body">
                            <h3 class="project-card__title">{{ project.title }}</h3>
                            <p class="project-card__loc">
                                <img width="20" height="20" src="{{ project.location_icon }}" alt="">
                                {{ project.address }}
                            </p>
                            <span class="btn-see-more btn-see-more--solid project-card__btn">xem thêm<span
                                    class="btn-see-more__icon btn-see-more__icon--sm"><i
                                        class="fa-solid fa-arrow-right"></i></span></span>
                        </div>
                    </a>
                </article>
                {% endfor %}
            </div>
            {% if homepage.projects.cards|length > 1 %}
            <div class="project-carousel__dots">
                {% for project in homepage.projects.cards %}
                <button type="button"{{ loop.first ? ' class="is-active"' }}></button>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {% if homepage.partners %}
    <div class="section section--gray partners">
        <div class="container">
            {% if homepage.partners.title %}
            <h2 class="t-heading-1 mb-4 mb-lg-5">{{ homepage.partners.title }}</h2>
            {% endif %}
            <div class="row g-4 g-xl-5 align-items-stretch">
                <div class="col-lg-4">
                    {% for stat in homepage.partners.stats %}
                    {% if not loop.first %}<hr class="partners__divider">{% endif %}
                    <div class="partners__stat{{ loop.last ? ' mb-4' : ' mb-3' }}">
                        <i class="{{ stat.icon_class }} partners__stat-icon{{ stat.icon_accent ? ' text-accent' : '' }}"></i>
                        <div>
                            <p class="partners__stat-value {{ stat.value_class }}">{{ stat.value }}</p>
                            <p class="partners__stat-label">{{ stat.label }}</p>
                        </div>
                    </div>
                    {% endfor %}
                    {% if homepage.partners.table_rows is not empty %}
                    <div class="table-responsive partners__table">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Quốc gia</th>
                                    <th scope="col" class="text-center">Khách hàng</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in homepage.partners.table_rows %}
                                <tr>
                                    <td>{% if row.bold %}<strong>{{ row.country }}</strong>{% else %}{{ row.country }}{% endif %}</td>
                                    <td class="text-center">{% if row.bold %}<strong>{{ row.count }}</strong>{% else %}{{ row.count }}{% endif %}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% endif %}
                </div>
                {% if homepage.partners.map_image %}
                <div class="col-lg-8 partners__map">
                    <img src="{{ homepage.partners.map_image }}" alt="{{ homepage.partners.title }}">
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {% if homepage.customers %}
    <div class="section customers">
        <div class="customers__bg">
            <div class="customers__earth-glow"></div>
            <img width="1920" height="762" class="customers__earth" src="{{ homepage.customers.bg_image }}" alt="">
        </div>
        <div class="container customers__inner">
            {% if homepage.customers.title %}
            <h2 class="t-heading-1 customers__title">{{ homepage.customers.title }}</h2>
            {% endif %}
            {% if homepage.customers.logos is not empty %}
            <div class="customers__logos">
                {% for logo in homepage.customers.logos %}
                <a class="customers__logo" href="{{ base_path }}#"><img width="188" height="72" src="{{ logo.url }}" alt="{{ logo.alt }}"></a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% if homepage.customers.testimonials is not empty %}
        <div class="container">
            <div class="customers__carousel-wrap">
                <div class="customers-testimonials owl-carousel">
                    {% for story in homepage.customers.testimonials %}
                    <blockquote class="testimonial-card{{ story.is_scroll ? ' testimonial-card--scroll' : '' }}">
                        {% if story.logo %}
                            {% if story.is_scroll %}
                            <div class="testimonial-card__logo-wrap">
                                <img class="testimonial-card__logo" src="{{ story.logo.url }}" alt="{{ story.logo.alt }}">
                            </div>
                            {% else %}
                            <img class="testimonial-card__logo" src="{{ story.logo.url }}" alt="{{ story.logo.alt }}">
                            {% endif %}
                        {% endif %}
                        {% if story.text %}
                        <div class="testimonial-card__body">
                            <p class="testimonial-card__text">{{ story.text }}</p>
                            {% if story.is_scroll %}
                            <div class="testimonial-card__scrollbar">
                                <span class="testimonial-card__scrollbar-thumb"></span>
                            </div>
                            {% endif %}
                        </div>
                        {% endif %}
                        {% if story.name or story.avatar %}
                        <div class="testimonial-card__author">
                            {% if story.avatar %}
                            <img width="68" height="68" class="testimonial-card__avatar" src="{{ story.avatar.url }}" alt="{{ story.avatar.alt }}">
                            {% endif %}
                            <div{{ story.is_scroll ? ' class="testimonial-card__meta"' : '' }}>
                                {% if story.name %}
                                <cite class="testimonial-card__name">{{ story.name }}</cite>
                                {% endif %}
                                {% if story.role %}
                                {% for role_line in story.role|split('\n') %}
                                <p class="testimonial-card__role">{{ role_line }}</p>
                                {% endfor %}
                                {% endif %}
                            </div>
                        </div>
                        {% endif %}
                    </blockquote>
                    {% endfor %}
                </div>
                {% if homepage.customers.testimonials|length > 1 %}
                <div class="customers__dots">
                    {% for story in homepage.customers.testimonials %}
                    <button type="button"{{ loop.first ? ' class="is-active"' }}></button>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {% if homepage.news is not empty %}
    <div class="section section--gray section--news">
        <div class="container">
            <h2 class="t-heading-1 section--news__title">Tin tức cập nhật</h2>
            <div class="section--news__carousel-wrap">
                <div class="news-carousel owl-carousel">
                    {% for item in homepage.news %}
                    <article class="news-card">
                        <a class="news-card__media" href="{{ item.url }}">
                            <img width="420" height="288" class="news-card__img" src="{{ item.image }}"
                                alt="{{ item.image_alt }}">
                        </a>
                        <div class="news-card__body">
                            <span class="news-card__cat">{{ item.category }}</span>
                            <h3 class="news-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                            <time class="news-card__date" datetime="{{ item.date_iso }}">{{ item.date }}</time>
                        </div>
                    </article>
                    {% endfor %}
                </div>
                {% if homepage.news|length > 1 %}
                <div class="news-carousel__dots">
                    {% for item in homepage.news %}
                    <button type="button"{{ loop.first ? ' class="is-active"' }}></button>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {% set cta = site_config.cta_banner %}
    <section class="cta-banner" id="lien-he">
        <div class="cta-banner__bg" aria-hidden="true">
            <video class="cta-banner__video" muted loop playsinline preload="metadata" data-autoplay-in-view>
                <source src="{{ cta.video_path }}" type="video/mp4">
            </video>
        </div>
        <div class="container">
            <div class="cta-banner__content">
                <div class="cta-banner__copy">
                    {% if cta.title %}
                    <h2 class="t-heading-1 cta-banner__title">{{ cta.title }}</h2>
                    {% endif %}
                    {% if cta.lead %}
                    <p class="cta-banner__lead">{{ cta.lead }}</p>
                    {% endif %}
                </div>
                <div class="cta-banner__actions">
                    {% if cta.phone %}
                    <a class="cta-btn cta-btn--phone" href="tel:{{ cta.phone_link }}">
                        <span class="cta-btn__label">{{ cta.phone }}</span>
                        <span class="cta-btn__icon"><i class="fa-regular fa-phone"></i></span>
                    </a>
                    {% endif %}
                    <a class="cta-btn cta-btn--quote" href="{{ cta.quote_url }}">
                        <span class="cta-btn__label">nhận báo giá</span>
                        <span class="cta-btn__icon"><i class="fa-solid fa-arrow-right"></i></span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    {% if homepage.certifications is not empty %}
    <section class="certifications" aria-label="Chứng nhận">
        <div class="container">
            <ul class="certifications__list">
                {% for cert in homepage.certifications %}
                <li class="certifications__item">
                    <div class="certifications__badge">
                        <img src="{{ cert.url }}" alt="{{ cert.alt }}">
                    </div>
                </li>
                {% endfor %}
            </ul>
        </div>
    </section>
    {% endif %}
