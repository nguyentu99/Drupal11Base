{#
/** Homepage section from html/index.html */
#}
<header class="site-header">
        <div class="container">
            <div class="site-header__inner">
                <a class="site-header__logo" href="{{ front_page }}">
                    <img width="232" height="40" src="/themes/cassiopeia_theme/images/cnc-logo.png" alt="CNC Industrial">
                </a>
                <div class="site-header__right">
                    <div class="site-header__tools d-none d-lg-flex">
                        <button type="button" class="site-header__search">
                            <i class="fa-regular fa-magnifying-glass"></i>
                        </button>
                        <span class="site-header__vsep"></span>
                        {{ include('@cassiopeia_theme/templates/header-lang-switcher.html.twig') }}
                        <a class="site-header__cta" href="{{ path('cassiopeia.contact') }}">{{ 'Schedule a visit'|t }}</a>
                    </div>
                    <div class="site-header__mobile-bar d-flex d-lg-none align-items-center">
                        <button type="button" class="site-header__search">
                            <i class="fa-regular fa-magnifying-glass"></i>
                        </button>
                        <span class="site-header__vsep"></span>
                        {{ include('@cassiopeia_theme/templates/header-lang-switcher.html.twig') }}
                        <button class="site-header__menu-toggle navbar-toggler border-0 shadow-none" type="button"
                            data-bs-toggle="collapse" data-bs-target=".main-nav" aria-label="{{ 'Menu'|t }}">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    </div>
                    <nav class="navbar navbar-expand-lg p-0">
                        <div class="collapse navbar-collapse justify-content-lg-end main-nav">
                            <button type="button" class="site-header__nav-close d-lg-none" data-bs-toggle="collapse"
                                data-bs-target=".main-nav" aria-label="{{ 'Close menu'|t }}">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                            {{ cassiopeia_menu('main', 1, 0, true) }}
                            <div class="site-header__mobile-cta d-lg-none mt-3 pt-3 border-top">
                                <a class="site-header__cta" href="{{ path('cassiopeia.contact') }}">{{ 'Schedule a visit'|t }}</a>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </header>
