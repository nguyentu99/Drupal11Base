<div id="app-wrapper" class="app-wrapper">
  {{ include('@cassiopeiaadmintheme/templates/header.html.twig', {
    account_menu: account_menu,
    logged_in: logged_in,
    current_user_display_name: current_user_display_name,
  }) }}
  {{ include('@cassiopeiaadmintheme/templates/appsidebar.html.twig', { administrator_menu: administrator_menu }) }}

  <main class="app-main">
    <div class="app-content-header">
      <div class="container-fluid">
        <div class="row">
          <div class="col-sm-6">
            <h3 class="mb-0">{{ page['#title'] }}</h3>
          </div>
          <div class="col-sm-6">
            <div class="float-sm-end">
              {{ page.breadcrumbs }}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="app-content">
      <div class="container-fluid">
        <div class="row">
          <div class="app-page-status-messages">{{ page.status_messages }}</div>
          <div class="app-page-highlighted">{{ page.highlighted }}</div>
          <div class="app-page-content">{{ page.content }}</div>
        </div>
      </div>
    </div>
  </main>

  {{ include('@cassiopeiaadmintheme/templates/footer.html.twig') }}
  {{ include('@cassiopeiaadmintheme/templates/controlsidebar.html.twig') }}
</div>
