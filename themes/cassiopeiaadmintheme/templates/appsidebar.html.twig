{# Sidebar: dynamic admin menu from cassiopeia_admin. #}
<aside class="app-sidebar sidebar-dark-primary bg-body-secondary shadow" data-bs-theme="dark">
  <div class="sidebar-brand">
    <a href="{{ path('<front>') }}" class="brand-link">
      <img src="{{ base_path }}{{ directory }}/images/AdminLTELogo.png" alt="{{ 'Admin logo'|t }}" class="brand-image opacity-75 shadow">
      <span class="brand-text fw-light">{{ 'Admin'|t }}</span>
    </a>
  </div>
  <div class="sidebar-wrapper">
    {% if current_user_display_name %}
      <div class="user-panel mt-3 pb-3 mb-3 d-flex">
        <div class="info">
          <span class="d-block">{{ current_user_display_name }}</span>
        </div>
      </div>
    {% endif %}
    <nav class="mt-2">
      {{ administrator_menu }}
    </nav>
  </div>
</aside>
