<?php

/**
 * @file
 * Theme hooks for Cassiopeia admin theme (AdminLTE layout).
 */

use Drupal\Core\Menu\MenuTreeParameters;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function cassiopeiaadmintheme_preprocess_html(array &$variables): void {
  $classes = ['layout-fixed', 'sidebar-expand-lg', 'bg-body-tertiary'];
  if (isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = array_merge($variables['attributes']['class'], $classes);
  }
  else {
    $variables['attributes']['class'] = $classes;
  }
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function cassiopeiaadmintheme_preprocess_page(array &$variables): void {
  if (\Drupal::moduleHandler()->moduleExists('cassiopeia_admin')) {
    $variables['administrator_menu'] = \Drupal::service('cassiopeia_admin.administrator')
      ->cassiopeia_admin_get_administrator_menu();
  }

  $account = \Drupal::currentUser();
  $variables['logged_in'] = $account->isAuthenticated();
  $variables['current_user_display_name'] = $variables['logged_in']
    ? $account->getDisplayName()
    : '';

  $parameters = new MenuTreeParameters();
  $parameters->onlyEnabledLinks();
  $tree = \Drupal::menuTree()->load('account', $parameters);
  $manipulators = [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ];
  $tree = \Drupal::menuTree()->transform($tree, $manipulators);
  $variables['account_menu'] = \Drupal::menuTree()->build($tree);
}

/**
 * Implements hook_preprocess_HOOK() for menu templates.
 */
function cassiopeiaadmintheme_preprocess_menu(array &$variables): void {
  if (($variables['menu_name'] ?? '') !== 'account') {
    return;
  }
  $account = \Drupal::currentUser();
  $variables['current_user_display_name'] = $account->isAuthenticated()
    ? $account->getDisplayName()
    : '';
  $variables['attributes']['class'][] = 'account-menu-root';
}
