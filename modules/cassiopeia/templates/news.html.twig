
<div class="warpper-content">
    <!-- banner -->
    <div class="banner">
        <div class="banner-container">
            <div id="main-slider">
                <div class="owl-carousel owl-theme main-slider">
                    <div class="item">
                        <img src="/themes/cassiopeiatheme/img/banner-2.png" class="img-responsive" alt="" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="breadcrumb-container">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cruise Blog</li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- /.banner -->

    <!-- main-content -->
    <div class="main-content">
        <div class="page home-page">
            <div class="page-container">
                <div class="page-inner">

                    <section class="sec-blog">
                        <div class="container">
                            <div class="title text-center">
                                Cruise Blog
                            </div>
                            <div class="row">
                                {% for new in variables %}
                                    <div class="col-md-4 col-sm-12 mt-3">
                                        <div class="blog-style">
                                            <div class="blog-img">
                                                <img src="/themes/cassiopeiatheme/img/blog.png" class="img-responsive" alt="">
                                            </div>
                                            <div class="blog-body">
                                                <div class="blog-header">
                                                    <div class="category">
                                                        <div class="cross"></div>
                                                        Cruise
                                                    </div>
                                                    <div class="date">
                                                        {{ new.created.value| date('D m, Y')}}
                                                    </div>
                                                </div>
                                                <div class="blog-heading">
                                                    {{ new.title.value }}
                                                </div>
                                                <div class="blog-description">
                                                    {{ new.body.summary|raw }}
                                                </div>
                                                <a href="{{ path('entity.node.canonical', {'node': new.nid.value}) }}" class="view-detail">
                                                    View Cruise <i class="fas fa-chevron-right"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </section>

                </div>
            </div>
        </div>
    </div>

    <!-- /.main-content -->
</div>
