<?php

/**
 * @file
 * Install and update hooks for the cassiopeia module.
 */

/**
 * Implements hook_schema().
 *
 * Legacy demo table removed; use config/content entities for new data.
 */
function cassiopeia_schema(): array {
  $schema['cassiopeia_contact_submission'] = [
    'description' => 'Stores public contact form submissions.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'email' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'phone' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'message' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'consent' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 20,
        'not null' => TRUE,
        'default' => 'new',
      ],
      'langcode' => [
        'type' => 'varchar',
        'length' => 12,
        'not null' => TRUE,
        'default' => 'vi',
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'created' => ['created'],
      'status' => ['status'],
      'email' => ['email'],
    ],
  ];

  return $schema;
}

/**
 * Drops unused legacy {test} table from early module versions.
 */
function cassiopeia_update_11001(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('test')) {
    $schema->dropTable('test');
  }
}

/**
 * Installs default Cassiopeia site settings configuration.
 */
function cassiopeia_update_11002(): void {
  $config = \Drupal::configFactory()->getEditable('cassiopeia.settings');
  if (!$config->isNew()) {
    return;
  }

  $path = \Drupal::service('extension.list.module')->getPath('cassiopeia') . '/config/install/cassiopeia.settings.yml';
  if (!is_readable($path)) {
    return;
  }

  $data = \Drupal\Component\Serialization\Yaml::decode((string) file_get_contents($path));
  if (is_array($data)) {
    $config->setData($data)->save();
  }
}

/**
 * Removes contact form submission storage and settings.
 */
function cassiopeia_update_11005(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('cassiopeia_contact_submission')) {
    $schema->dropTable('cassiopeia_contact_submission');
  }

  $config = \Drupal::configFactory()->getEditable('cassiopeia.settings');
  if ($config->get('contact_form') !== NULL) {
    $config->clear('contact_form')->save();
  }
}

/**
 * Re-enables contact form submissions storage and default settings.
 */
function cassiopeia_update_11006(): void {
  $schema = cassiopeia_schema();
  $db_schema = \Drupal::database()->schema();
  if (!$db_schema->tableExists('cassiopeia_contact_submission')) {
    $db_schema->createTable('cassiopeia_contact_submission', $schema['cassiopeia_contact_submission']);
  }

  $config = \Drupal::configFactory()->getEditable('cassiopeia.settings');
  if ($config->get('contact_form')) {
    return;
  }

  $path = \Drupal::service('extension.list.module')->getPath('cassiopeia') . '/config/install/cassiopeia.settings.yml';
  if (!is_readable($path)) {
    return;
  }

  $data = \Drupal\Component\Serialization\Yaml::decode((string) file_get_contents($path));
  if (!empty($data['contact_form']) && is_array($data['contact_form'])) {
    $config->set('contact_form', $data['contact_form'])->save();
  }
}

/**
 * Removes unused contact form label settings from config.
 */
function cassiopeia_update_11007(): void {
  $config = \Drupal::configFactory()->getEditable('cassiopeia.settings');
  $contact_form = $config->get('contact_form');
  if (!is_array($contact_form)) {
    return;
  }

  foreach ([
    'name_label',
    'name_placeholder',
    'email_label',
    'email_placeholder',
    'phone_label',
    'phone_placeholder',
    'message_label',
    'message_placeholder',
    'submit_label',
    'success_message',
  ] as $key) {
    unset($contact_form[$key]);
  }

  $config->set('contact_form', $contact_form)->save();
}

/**
 * Installs Dịch vụ content type, fields, and paragraph bundles.
 */
function cassiopeia_update_11008(): string {
  /** @var \Drupal\cassiopeia\Service\DichVuContentInstaller $installer */
  $installer = \Drupal::service('cassiopeia.dich_vu_content_installer');
  $installer->install();
  return (string) t('Installed Dịch vụ content type with fields and paragraphs.');
}

/**
 * Imports four Dịch vụ nodes from HTML content definitions.
 */
function cassiopeia_update_11009(): string {
  /** @var \Drupal\cassiopeia\Service\DichVuContentImporter $importer */
  $importer = \Drupal::service('cassiopeia.dich_vu_content_importer');
  $messages = $importer->import();
  return implode(' ', $messages);
}

/**
 * Fixes text formats on imported Dịch vụ nodes (full_html → basic_html).
 */
function cassiopeia_update_11010(): string {
  $field = \Drupal\field\Entity\FieldConfig::load('node.dich_vu.body');
  if ($field) {
    $field->setSetting('allowed_formats', ['basic_html']);
    $field->save();
  }

  /** @var \Drupal\cassiopeia\Service\DichVuContentImporter $importer */
  $importer = \Drupal::service('cassiopeia.dich_vu_content_importer');
  $messages = $importer->fixTextFormats();
  return implode(' ', $messages);
}

/**
 * Seeds homepage banner and project aliases for front page data binding.
 */
function cassiopeia_update_11011(): string {
  /** @var \Drupal\cassiopeia\Service\HomepageContentImporter $importer */
  $importer = \Drupal::service('cassiopeia.homepage_content_importer');
  $messages = $importer->import();
  return implode(' ', $messages);
}

/**
 * Installs home_config content type, fields, and paragraph bundles.
 */
function cassiopeia_update_11012(): string {
  /** @var \Drupal\cassiopeia\Service\HomeConfigContentInstaller $installer */
  $installer = \Drupal::service('cassiopeia.home_config_content_installer');
  $installer->install();
  return (string) t('Installed home_config content type with fields and paragraphs.');
}

/**
 * Seeds the home_config node from legacy homepage static content.
 */
function cassiopeia_update_11013(): string {
  /** @var \Drupal\cassiopeia\Service\HomeConfigContentImporter $importer */
  $importer = \Drupal::service('cassiopeia.home_config_content_importer');
  $messages = $importer->import();
  return implode(' ', $messages);
}

/**
 * Makes image alt text optional on home_config image fields.
 */
function cassiopeia_update_11014(): string {
  /** @var \Drupal\cassiopeia\Service\HomeConfigContentInstaller $installer */
  $installer = \Drupal::service('cassiopeia.home_config_content_installer');
  $installer->relaxImageAltRequirement();
  return (string) t('Image alt text is no longer required on home_config fields.');
}

/**
 * Enables content translation for home_config and related paragraph types.
 */
function cassiopeia_update_11015(): string {
  if (!\Drupal::moduleHandler()->moduleExists('content_translation')) {
    \Drupal::service('module_installer')->install(['content_translation'], TRUE);
  }

  /** @var \Drupal\cassiopeia\Service\HomeConfigContentInstaller $installer */
  $installer = \Drupal::service('cassiopeia.home_config_content_installer');
  $installer->enableContentTranslation();
  return (string) t('Enabled content translation for home_config.');
}
