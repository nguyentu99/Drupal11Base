    ],
    'sidebar' => cassiopeia_market_research_related_items($node, 4),
    'related' => cassiopeia_market_research_related_items($node, 9),
  ];
}

/**
 * Builds a URL fragment id for handbook paragraph sections.
 */
function cassiopeia_investment_handbook_section_id(string $title, int $delta, array &$used = []): string {
  $transliteration = \Drupal::service('transliteration');
  $slug = mb_strtolower($transliteration->transliterate($title, 'en', '-'));
  $slug = preg_replace('/[^a-z0-9-]+/', '-', $slug);
  $slug = trim($slug, '-');
  if ($slug === '') {
    $slug = 'section-' . $delta;
  }
  $base = $slug;
  $suffix = 1;
  while (isset($used[$slug])) {
    $slug = $base . '-' . $suffix++;
  }
  $used[$slug] = TRUE;
  return $slug;
}

/**
 * Base entity query for published investment_handbook nodes.
 */
function cassiopeia_investment_handbook_node_query(): QueryInterface {
  return \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'investment_handbook')
    ->condition('status', 1);
}

/**
 * Builds teaser data for an investment_handbook node.
 */
function cassiopeia_investment_handbook_teaser_data(NodeInterface $node, $image_style = NULL): array {
  $image_style ??= \Drupal::entityTypeManager()->getStorage('image_style')->load('wide')
    ?: \Drupal::entityTypeManager()->getStorage('image_style')->load('large');

  $image = NULL;
  if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
    $image_item = $node->get('field_image')->first();
    $file = $image_item?->entity;
    if ($file) {
      $uri = $file->getFileUri();
      $image = [
        'url' => cassiopeia_image_url($uri, $image_style),
        'alt' => (string) ($image_item->alt ?: $node->label()),
        'width' => $image_item->width ?? NULL,
        'height' => $image_item->height ?? NULL,
      ];
    }
  }

  return [
    'title' => $node->label(),
    'url' => $node->toUrl('canonical', ['language' => $node->language()])->toString(),
    'image' => $image,
  ];
}

/**
 * Parses paragraph sections for handbook detail pages.
 *
 * @return array{sections: array<int, array<string, mixed>>, nav: array<int, array<string, mixed>>}
 */
function cassiopeia_investment_handbook_sections(NodeInterface $node): array {
  $sections = [];
  $nav = [];
  $used = [];

  if (!$node->hasField('field_para_content') || $node->get('field_para_content')->isEmpty()) {
    return ['sections' => [], 'nav' => []];
  }

  $delta = 0;
  foreach ($node->get('field_para_content') as $item) {
    $paragraph = $item->entity;
    if (!$paragraph) {
      continue;
    }

    $nav_title = '';
    if ($paragraph->hasField('field_title') && !$paragraph->get('field_title')->isEmpty()) {
      $nav_title = (string) $paragraph->get('field_title')->value;
    }

    $body = '';
    if ($paragraph->hasField('field_body') && !$paragraph->get('field_body')->isEmpty()) {
      $body = Markup::create($paragraph->get('field_body')->processed);
    }

    if ($nav_title === '' && $body === '') {
      continue;
    }

    $id = cassiopeia_investment_handbook_section_id(
      $nav_title !== '' ? $nav_title : 'section-' . $delta,
      $delta,
      $used,
    );

    $sections[] = [
      'id' => $id,
      'nav_title' => $nav_title,
      'body' => $body,
    ];

    if ($nav_title !== '') {
      $nav[] = [
        'id' => $id,
        'title' => $nav_title,
        'url' => '#' . $id,
        'active' => $delta === 0,
      ];
    }

    $delta++;
  }

  return ['sections' => $sections, 'nav' => $nav];
}

