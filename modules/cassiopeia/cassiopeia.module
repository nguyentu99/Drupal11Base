/**
 * Language-aware URL for the contact page.
 */
function cassiopeia_contact_url(array $options = []): string {
  $options += ['language' => \Drupal::languageManager()->getCurrentLanguage()];
  return Url::fromRoute('cassiopeia.contact', [], $options)->toString();
}

/**
 * Returns a public URL for a config-managed file ID.
 */
function cassiopeia_config_file_url(int $fid, ?string $fallback = NULL): ?string {
  if ($fid > 0) {
    $file = File::load($fid);
    if ($file) {
      return \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
    }
  }
  return $fallback;
}

/**
 * Normalizes a phone number for tel: links.
 */
function cassiopeia_normalize_phone_link(string $phone, string $fallback = ''): string {
  $link = preg_replace('/\D+/', '', $phone) ?? '';
  return $link !== '' ? $link : $fallback;
}

/**
 * Builds processed site configuration for templates.
 */
function cassiopeia_site_config(?string $section = NULL): array {
  static $built;
  if ($built === NULL) {
    $config = \Drupal::config('cassiopeia.settings');
    $theme_path = '/' . \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');
    $strip = $config->get('contact_strip') ?: [];
    $cta = $config->get('cta_banner') ?: [];

    $phone_link = $strip['phone_link'] ?? '';
    if ($phone_link === '' && !empty($strip['phone'])) {
      $phone_link = cassiopeia_normalize_phone_link((string) $strip['phone']);
    }

    $cta_phone_link = $cta['phone_link'] ?? '';
    if ($cta_phone_link === '' && !empty($cta['phone'])) {
      $cta_phone_link = cassiopeia_normalize_phone_link((string) $cta['phone']);
    }

    $quote_url = trim((string) ($cta['quote_url'] ?? ''));
    if ($quote_url === '') {
      $quote_url = cassiopeia_contact_url();
    }
    elseif (!str_starts_with($quote_url, 'http')) {
      $quote_url = Url::fromUserInput($quote_url)->toString();
    }

    $map_url = trim((string) ($strip['map_url'] ?? ''));
    if ($map_url !== '' && !str_starts_with($map_url, 'http')) {
      $map_url = Url::fromUserInput($map_url)->toString();
    }

    $built = [
      'contact_strip' => [
        'phone_label' => (string) ($strip['phone_label'] ?? ''),
        'phone' => (string) ($strip['phone'] ?? ''),
        'phone_link' => $phone_link,
        'email_label' => (string) ($strip['email_label'] ?? ''),
        'email' => (string) ($strip['email'] ?? ''),
        'social_label' => (string) ($strip['social_label'] ?? ''),
        'facebook_url' => (string) ($strip['facebook_url'] ?? ''),
        'youtube_url' => (string) ($strip['youtube_url'] ?? ''),
        'linkedin_url' => (string) ($strip['linkedin_url'] ?? ''),
        'map_label' => (string) ($strip['map_label'] ?? ''),
        'address' => (string) ($strip['address'] ?? ''),
        'map_url' => $map_url,
      ],
      'cta_banner' => [
        'title' => (string) ($cta['title'] ?? ''),
        'lead' => (string) ($cta['lead'] ?? ''),
        'phone' => (string) ($cta['phone'] ?? ''),
        'phone_link' => $cta_phone_link,
        'quote_url' => $quote_url,
        'video_path' => (string) ($cta['video_path'] ?? $theme_path . '/images/video-thuml.mp4'),
      ],
    ];
  }

  if ($section !== NULL) {
    return $built[$section] ?? [];
  }
  return $built;
}

/**
 * Builds variables for the contact page template.
 */
function cassiopeia_contact_page_variables(): array {
  $config = \Drupal::config('cassiopeia.settings');
  $raw = $config->get('contact_page') ?: [];
  $strip = cassiopeia_site_config('contact_strip');
  $theme_path = '/' . \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');
  $language = \Drupal::languageManager()->getCurrentLanguage();

  $qr_codes = [];
  foreach ($raw['qr_codes'] ?? [] as $item) {
    $image = cassiopeia_config_file_url((int) ($item['image'] ?? 0));
    $logo = cassiopeia_config_file_url((int) ($item['logo'] ?? 0));
    if (($item['label'] ?? '') === '' && $image === NULL) {
      continue;
    }
    $qr_codes[] = [
      'label' => (string) ($item['label'] ?? ''),
      'image' => $image,
      'logo' => $logo,
    ];
  }

  $address_map_url = trim((string) ($raw['address_map_url'] ?? ''));
  if ($address_map_url !== '' && !str_starts_with($address_map_url, 'http')) {
    $address_map_url = Url::fromUserInput($address_map_url)->toString();
  }

  return [
    'hero_title' => (string) ($raw['hero_title'] ?? ''),
    'hero_lead' => (string) ($raw['hero_lead'] ?? ''),
    'hero_image' => cassiopeia_config_file_url((int) ($raw['hero_image'] ?? 0), $theme_path . '/images/contact/hero.jpg'),
    'aside_title' => (string) ($raw['aside_title'] ?? ''),
    'aside_description' => (string) ($raw['aside_description'] ?? ''),
    'aside_image' => cassiopeia_config_file_url((int) ($raw['aside_image'] ?? 0), $theme_path . '/images/contact/panel-bg.jpg'),
    'phone' => $strip['phone'],
    'phone_link' => $strip['phone_link'],
    'email' => $strip['email'],
    'address' => (string) ($raw['address'] ?? $strip['address']),
    'map_embed' => (string) ($raw['map_embed'] ?? ''),
    'intl_section_title' => (string) ($raw['intl_section_title'] ?? ''),
    'qr_codes' => $qr_codes,
    'address_title' => (string) ($raw['address_title'] ?? ''),
    'office_name' => (string) ($raw['office_name'] ?? ''),
    'address_map_url' => $address_map_url,
    'breadcrumb' => [
      [
        'label' => t('Home'),
        'url' => Url::fromRoute('<front>', [], ['language' => $language])->toString(),
      ],
      [
        'label' => (string) ($raw['hero_title'] ?? t('Contact')),
        'url' => NULL,
      ],
    ],
  ];
}

/**
 * Returns contact form settings (fixed labels + configurable consent/notify).
 */
function cassiopeia_contact_form_settings(): array {
  $raw = \Drupal::config('cassiopeia.settings')->get('contact_form') ?: [];
  $terms_url = trim((string) ($raw['terms_url'] ?? ''));
  if ($terms_url !== '' && !str_starts_with($terms_url, 'http')) {
    $terms_url = Url::fromUserInput($terms_url)->toString();
  }

  return [
    'name_label' => (string) t('Full name'),
    'name_placeholder' => (string) t('Full name'),
    'email_label' => (string) t('Email'),
    'email_placeholder' => (string) t('Email address'),
    'phone_label' => (string) t('Phone number'),
    'phone_placeholder' => (string) t('Phone number'),
    'message_label' => (string) t('Consultation request'),
    'message_placeholder' => (string) t('Enter your message…'),
    'submit_label' => (string) t('Send information'),
    'success_message' => (string) t('Thank you. We have received your request and will contact you soon.'),
    'notify_email' => (string) ($raw['notify_email'] ?? ''),
    'terms_url' => $terms_url,
    'consent_before' => (string) ($raw['consent_before'] ?? (string) t('I agree to the')),
    'consent_link_text' => (string) ($raw['consent_link_text'] ?? (string) t('terms of consent')),
    'consent_after' => (string) ($raw['consent_after'] ?? (string) t('for providing information to CNC Industrial')),
  ];
}

/**
 * Builds consent checkbox title markup.
 */
function cassiopeia_contact_form_consent_title(array $settings): Markup {
  $parts = [htmlspecialchars($settings['consent_before'], ENT_QUOTES, 'UTF-8')];
  if ($settings['terms_url'] !== '') {
    $parts[] = '<a href="' . htmlspecialchars($settings['terms_url'], ENT_QUOTES, 'UTF-8') . '">'
      . htmlspecialchars($settings['consent_link_text'], ENT_QUOTES, 'UTF-8') . '</a>';
  }
  else {
    $parts[] = htmlspecialchars($settings['consent_link_text'], ENT_QUOTES, 'UTF-8');
  }
  $parts[] = htmlspecialchars($settings['consent_after'], ENT_QUOTES, 'UTF-8');
  return Markup::create(implode(' ', $parts));
}

/**
 * Saves a contact submission and returns its ID.
 */
function cassiopeia_contact_submission_save(array $values): int {
  $values += [
    'message' => '',
    'consent' => 0,
    'status' => 'new',
    'langcode' => \Drupal::languageManager()->getCurrentLanguage()->getId(),
    'created' => \Drupal::time()->getRequestTime(),
  ];

  return (int) \Drupal::database()->insert('cassiopeia_contact_submission')
    ->fields([
      'name' => $values['name'],
      'email' => $values['email'],
      'phone' => $values['phone'],
      'message' => $values['message'],
      'consent' => (int) $values['consent'],
      'status' => $values['status'],
      'langcode' => $values['langcode'],
      'created' => (int) $values['created'],
    ])
    ->execute();
}

/**
 * Loads a contact submission by ID.
 */
function cassiopeia_contact_submission_load(int $id): ?array {
  $record = \Drupal::database()->select('cassiopeia_contact_submission', 'c')
    ->fields('c')
    ->condition('id', $id)
    ->execute()
    ->fetchAssoc();
  return $record ?: NULL;
}

/**
 * Updates a contact submission.
 */
function cassiopeia_contact_submission_update(int $id, array $values): void {
  \Drupal::database()->update('cassiopeia_contact_submission')
    ->fields($values)
    ->condition('id', $id)
    ->execute();
}

/**
 * Deletes a contact submission.
 */
function cassiopeia_contact_submission_delete(int $id): void {
  \Drupal::database()->delete('cassiopeia_contact_submission')
    ->condition('id', $id)
    ->execute();
}

/**
 * Counts contact submissions.
 */
function cassiopeia_contact_submission_count(array $filters = []): int {
  $query = \Drupal::database()->select('cassiopeia_contact_submission', 'c');
  $query->addExpression('COUNT(*)');
  if (!empty($filters['status'])) {
    $query->condition('status', $filters['status']);
  }
  return (int) $query->execute()->fetchField();
}

/**
 * Lists contact submissions.
 *
 * @return array{items: array<int, array<string, mixed>>, total: int}
 */
function cassiopeia_contact_submission_list(array $options = []): array {
  $options += [
    'status' => NULL,
    'limit' => 25,
    'offset' => 0,
  ];

  $filters = ['status' => $options['status']];
  $total = cassiopeia_contact_submission_count($filters);

  $query = \Drupal::database()->select('cassiopeia_contact_submission', 'c')
    ->fields('c')
    ->orderBy('created', 'DESC')
    ->range($options['offset'], $options['limit']);
  if ($options['status']) {
    $query->condition('status', $options['status']);
  }

  return [
    'items' => $query->execute()->fetchAll(\PDO::FETCH_ASSOC) ?: [],
    'total' => $total,
  ];
}

/**
 * Implements hook_mail().
 */
function cassiopeia_mail($key, &$message, $params): void {
  if ($key !== 'contact_submission' || empty($params['submission'])) {
    return;
  }

  $submission = $params['submission'];
  $message['subject'] = t('New contact submission from @name', [
    '@name' => $submission['name'],
  ]);
  $message['body'][] = implode("\n", [
    t('Name: @name', ['@name' => $submission['name']]),
    t('Email: @email', ['@email' => $submission['email']]),
    t('Phone: @phone', ['@phone' => $submission['phone']]),
    t('Message: @message', ['@message' => $submission['message'] !== '' ? $submission['message'] : t('(empty)')]),
    t('Submitted: @date', ['@date' => \Drupal::service('date.formatter')->format((int) $submission['created'], 'long')]),
  ]);
}

/**
 * Groups office headquarters paragraphs by province.
 *
 * @return array<int, array{province: string, addresses: string[]}>
 */
function cassiopeia_active_network_office_regions(NodeInterface $node): array {
  if (!$node->hasField('field_tsvp') || $node->get('field_tsvp')->isEmpty()) {
    return [];
  }

  $regions = [];
  $index = [];
  foreach ($node->get('field_tsvp') as $item) {
    $paragraph = $item->entity;
    if (!$paragraph instanceof ParagraphInterface || $paragraph->bundle() !== 'para_office_headquarters') {
      continue;
    }
    $province = trim((string) ($paragraph->get('field_province')->value ?? ''));
    $address = trim((string) ($paragraph->get('field_address')->value ?? ''));
    if ($province === '') {
      continue;
    }
    if (!isset($index[$province])) {
      $index[$province] = count($regions);
      $regions[] = [
        'province' => $province,
        'addresses' => [],
      ];
    }
    if ($address !== '') {
      $regions[$index[$province]]['addresses'][] = $address;
    }
  }

  return $regions;
}

/**
 * Groups project paragraphs by province.
 *
 * @return array<int, array{province: string, projects: array<int, array{name: string, area: string}>}>
 */
function cassiopeia_active_network_project_regions(NodeInterface $node): array {
  if (!$node->hasField('field_da') || $node->get('field_da')->isEmpty()) {
    return [];
  }

  $regions = [];
  $index = [];
  foreach ($node->get('field_da') as $item) {
    $paragraph = $item->entity;
    if (!$paragraph instanceof ParagraphInterface || $paragraph->bundle() !== 'cac_du_an') {
      continue;
    }
    $province = trim((string) ($paragraph->get('field_province')->value ?? ''));
    if ($province === '') {
      continue;
    }

    $projects = [];
    if ($paragraph->hasField('field_para_para_content') && !$paragraph->get('field_para_para_content')->isEmpty()) {
      foreach ($paragraph->get('field_para_para_content') as $child_item) {
        $child = $child_item->entity;
        if (!$child instanceof ParagraphInterface || $child->bundle() !== 'vi_tri') {
          continue;
        }
        $name = trim((string) ($child->get('field_address')->value ?? ''));
        $area = trim((string) ($child->get('field_unit')->value ?? ''));
        if ($name === '' && $area === '') {
          continue;
        }
        $projects[] = [
          'name' => $name,
          'area' => $area,
        ];
      }
    }

    if (!isset($index[$province])) {
      $index[$province] = count($regions);
      $regions[] = [
        'province' => $province,
        'projects' => $projects,
      ];
    }
    else {
      $regions[$index[$province]]['projects'] = array_merge(
        $regions[$index[$province]]['projects'],
        $projects,
      );
    }
  }

  return $regions;
}

/**
 * Builds unique province filter options from office and project regions.
 *
 * @return string[]
 */
function cassiopeia_active_network_filter_provinces(array $offices, array $projects): array {
  $provinces = [];
  foreach (array_merge($offices, $projects) as $region) {
    $province = (string) ($region['province'] ?? '');
    if ($province !== '' && !in_array($province, $provinces, TRUE)) {
      $provinces[] = $province;
    }
  }
  return $provinces;
}

/**
 * Builds variables for active_network detail templates.
 */
function cassiopeia_active_network_detail_variables(NodeInterface $node): array {
  $language = $node->language();
  $title = $node->label();
  $theme_path = \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');
  $banner = cassiopeia_page_banner('active_network', $title, $language);

  $map_image = '/' . $theme_path . '/images/network/map-mang-luoi.svg';
  $map_alt = (string) t('CNC Industrial active network map in Vietnam');
  if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
    $file = $node->get('field_image')->entity;
    if ($file instanceof File) {
      $map_image = cassiopeia_image_url($file->getFileUri());
      $alt = trim((string) ($node->get('field_image')->alt ?? ''));
      if ($alt !== '') {
        $map_alt = $alt;
      }
    }
  }

  $offices = cassiopeia_active_network_office_regions($node);
  $projects = cassiopeia_active_network_project_regions($node);

  return [
    'title' => $title,
    'hero_image' => $banner['hero_image'],
    'hero_image_alt' => $banner['hero_image_alt'],
    'map_image' => $map_image,
    'map_alt' => $map_alt,
    'offices_title' => (string) t('Office headquarters'),
    'projects_title' => (string) t('Projects'),
    'filter_all_label' => (string) t('All locations'),
    'filter_provinces' => cassiopeia_active_network_filter_provinces($offices, $projects),
    'offices' => $offices,
    'projects' => $projects,
    'breadcrumb' => [
      [
        'label' => t('Home'),
        'url' => Url::fromRoute('<front>', [], ['language' => $language])->toString(),
      ],
      [
        'label' => t('About us'),
        'url' => NULL,
      ],
      [
        'label' => $title,
        'url' => NULL,
      ],
    ],
  ];
}

/**
 * Builds image data from an image field item.
 *
 * @return array{url: string, alt: string}|null
 */
function cassiopeia_image_field_item_data($item): ?array {
  if (!$item || !$item->entity) {
    return NULL;
  }
  $file = $item->entity;
  return [
    'url' => cassiopeia_image_url($file->getFileUri()),
    'alt' => trim((string) ($item->alt ?? '')),
  ];
}

/**
 * Converts a YouTube URL to an embed URL.
 */
function cassiopeia_youtube_embed_url(string $url): ?string {
  $url = trim($url);
  if ($url === '') {
    return NULL;
  }

  if (preg_match('#youtube\.com/embed/([a-zA-Z0-9_-]{11})#', $url, $matches)) {
    return 'https://www.youtube.com/embed/' . $matches[1];
  }
  if (preg_match('#(?:youtube\.com/watch\?(?:[^&]+&)*v=|youtube\.com/v/)([a-zA-Z0-9_-]{11})#', $url, $matches)) {
    return 'https://www.youtube.com/embed/' . $matches[1];
  }
  if (preg_match('#youtu\.be/([a-zA-Z0-9_-]{11})#', $url, $matches)) {
    return 'https://www.youtube.com/embed/' . $matches[1];
  }
  if (preg_match('#youtube\.com/shorts/([a-zA-Z0-9_-]{11})#', $url, $matches)) {
    return 'https://www.youtube.com/embed/' . $matches[1];
  }

  return NULL;
}

/**
 * Builds carousel story data from a customer story paragraph.
 *
 * @return array<string, mixed>
 */
function cassiopeia_partner_story_data(ParagraphInterface $paragraph): array {
  $body = '';
  if ($paragraph->hasField('field_body') && !$paragraph->get('field_body')->isEmpty()) {
    $body = (string) $paragraph->get('field_body')->value;
  }
  $text = trim(html_entity_decode(strip_tags($body), ENT_QUOTES | ENT_HTML5, 'UTF-8'));

  return [
    'logo' => $paragraph->hasField('field_anh') && !$paragraph->get('field_anh')->isEmpty()
      ? cassiopeia_image_field_item_data($paragraph->get('field_anh')->first())
      : NULL,
    'avatar' => $paragraph->hasField('field_avatar') && !$paragraph->get('field_avatar')->isEmpty()
      ? cassiopeia_image_field_item_data($paragraph->get('field_avatar')->first())
      : NULL,
    'text' => $text,
    'is_scroll' => mb_strlen($text) > 280,
    'name' => trim((string) ($paragraph->get('field_title')->value ?? '')),
    'role' => trim((string) ($paragraph->get('field_unit')->value ?? '')),
  ];
}

/**
 * Builds video story data from a customer story video paragraph.
 *
 * @return array<string, mixed>
 */
function cassiopeia_partner_video_story_data(ParagraphInterface $paragraph): array {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');
  $story = cassiopeia_partner_story_data($paragraph);

  $poster = '/' . $theme_path . '/images/partners/story-video.jpg';
  if ($paragraph->hasField('field_avatar') && !$paragraph->get('field_avatar')->isEmpty()) {
    $avatar = cassiopeia_image_field_item_data($paragraph->get('field_avatar')->first());
    if ($avatar) {
      $poster = $avatar['url'];
    }
  }

  $youtube_embed = NULL;
  if ($paragraph->hasField('field_video') && !$paragraph->get('field_video')->isEmpty()) {
    $youtube_embed = cassiopeia_youtube_embed_url((string) $paragraph->get('field_video')->value);
  }

  return $story + [
    'poster' => $poster,
    'youtube_embed' => $youtube_embed,
  ];
}

/**
 * Builds trusted partner logos from the node image field.
 *
 * @return array<int, array{url: string, alt: string}>
 */
function cassiopeia_partner_trusted_logos(NodeInterface $node): array {
  if (!$node->hasField('field_anh') || $node->get('field_anh')->isEmpty()) {
    return [];
  }

  $logos = [];
  foreach ($node->get('field_anh') as $item) {
    $logo = cassiopeia_image_field_item_data($item);
    if ($logo) {
      $logos[] = $logo;
    }
  }
  return $logos;
}

/**
 * Builds teaser data for a projects node card.
 *
 * @return array<string, mixed>
 */
function cassiopeia_projects_teaser_data(NodeInterface $node): array {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');
  $fallback_image = '/' . $theme_path . '/images/du-an-banner.jpg';
  $image_url = $fallback_image;
  $image_alt = $node->label();

  if ($node->hasField('field_anh') && !$node->get('field_anh')->isEmpty()) {
    $image = cassiopeia_image_field_item_data($node->get('field_anh')->first());
    if ($image) {
      $image_url = $image['url'];
      $image_alt = $image['alt'] ?: $image_alt;
    }
  }

  return [
    'title' => $node->label(),
    'url' => $node->toUrl('canonical')->toString(),
    'image' => $image_url,
    'image_alt' => $image_alt,
    'address' => $node->hasField('field_address') && !$node->get('field_address')->isEmpty()
      ? trim((string) $node->get('field_address')->value)
      : '',
  ];
}

/**
 * Loads related published projects excluding the current node.
 *
 * @return array<int, array<string, mixed>>
 */
function cassiopeia_projects_related(NodeInterface $node, int $limit = 6): array {
  $query = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'projects')
    ->condition('status', 1)
    ->condition('nid', $node->id(), '<>')
    ->range(0, $limit)
    ->sort('created', 'DESC');

  if (\Drupal::moduleHandler()->moduleExists('content_translation')) {
    $query->condition('langcode', $node->language()->getId());
  }

  $nids = $query->execute();
  if (!$nids) {
    return [];
  }

  $items = [];
  /** @var \Drupal\node\NodeInterface[] $nodes */
  $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
  foreach ($nids as $nid) {
    if (isset($nodes[$nid])) {
      $items[] = cassiopeia_projects_teaser_data($nodes[$nid]);
    }
  }

  return $items;
}

/**
 * Extracts plain-text paragraphs from processed HTML.
 *
 * @return array<int, string>
 */
function cassiopeia_html_paragraph_texts(string $html): array {
  $paragraphs = [];
  if (preg_match_all('#<p[^>]*>(.*?)</p>#is', $html, $matches)) {
    foreach ($matches[1] as $paragraph) {
      $text = trim(html_entity_decode(strip_tags($paragraph), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
      if ($text !== '') {
        $paragraphs[] = $text;
      }
    }
  }

  if (!$paragraphs) {
    $text = trim(html_entity_decode(strip_tags($html), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
    if ($text !== '') {
      $paragraphs[] = $text;
    }
  }

  return $paragraphs;
}

/**
 * Extracts intro paragraphs from a node body field.
 *
 * @return array<int, string>
 */
function cassiopeia_projects_intro_paragraphs(NodeInterface $node): array {
  if (!$node->hasField('body') || $node->get('body')->isEmpty()) {
    return [];
  }

  return cassiopeia_html_paragraph_texts((string) $node->get('body')->processed);
}

/**
 * Builds one infrastructure card from a co_so_ha_tang paragraph.
 *
 * @return array{icon: ?array, title: string, texts: array<int, string>}|null
 */
function cassiopeia_projects_infrastructure_item(ParagraphInterface $paragraph): ?array {
  if ($paragraph->bundle() !== 'co_so_ha_tang') {
    return NULL;
  }

  $icon = $paragraph->hasField('field_anh') && !$paragraph->get('field_anh')->isEmpty()
    ? cassiopeia_image_field_item_data($paragraph->get('field_anh')->first())
    : NULL;
  $title = trim((string) ($paragraph->get('field_title')->value ?? ''));
  $texts = [];
  if ($paragraph->hasField('field_body') && !$paragraph->get('field_body')->isEmpty()) {
    $texts = cassiopeia_html_paragraph_texts((string) $paragraph->get('field_body')->processed);
  }

  if ($title === '' && !$texts && !$icon) {
    return NULL;
  }

  return [
    'icon' => $icon,
    'title' => $title,
    'texts' => $texts,
  ];
}

/**
 * Builds tax benefit list items for a projects detail page.
 *
 * @return array<int, string>
 */
function cassiopeia_projects_tax_benefits(NodeInterface $node): array {
  $benefits = [];

  if ($node->hasField('field_tax_benefits') && !$node->get('field_tax_benefits')->isEmpty()) {
    foreach ($node->get('field_tax_benefits') as $item) {
      $paragraph = $item->entity;
      if (!$paragraph instanceof ParagraphInterface) {
        continue;
      }
      foreach (['field_body', 'field_content'] as $field_name) {
        if (!$paragraph->hasField($field_name) || $paragraph->get($field_name)->isEmpty()) {
          continue;
        }
        foreach (cassiopeia_html_paragraph_texts((string) $paragraph->get($field_name)->processed) as $text) {
          $benefits[] = $text;
        }
      }
      if ($benefits === [] && $paragraph->hasField('field_title') && !$paragraph->get('field_title')->isEmpty()) {
        $benefits[] = trim((string) $paragraph->get('field_title')->value);
      }
    }
  }

  if ($benefits === [] && $node->hasField('field_tax') && !$node->get('field_tax')->isEmpty()) {
    $benefits = cassiopeia_html_paragraph_texts((string) $node->get('field_tax')->processed);
  }

  if ($benefits !== []) {
    return $benefits;
  }

  return [
    (string) t('Corporate income tax: Based on taxable income, 100% tax exemption for the first 2 years and a 50% reduction of payable tax for the following 4 years.'),
    (string) t('VAT: Imported machinery, equipment, and specialized vehicles serving production are VAT-exempt if not yet manufactured domestically. Tax rate: 0%.'),
  ];
}

/**
 * Builds tax section image data for a projects detail page.
 *
 * @return array{url: string, alt: string}
 */
function cassiopeia_projects_tax_image(NodeInterface $node, string $title): array {
  foreach (['field_tax_image', 'field_image_tax'] as $field_name) {
    if ($node->hasField($field_name) && !$node->get($field_name)->isEmpty()) {
      $image = cassiopeia_image_field_item_data($node->get($field_name)->first());
      if ($image) {
        return [
          'url' => $image['url'],
          'alt' => $image['alt'] ?: $title,
        ];
      }
    }
  }

  $theme_path = \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');
  $candidates = [
    'images/thue.jpg',
    'images/customers/khach-hang-banner.jpg',
    'images/du-an-banner.jpg',
  ];
  foreach ($candidates as $relative) {
    $uri = DRUPAL_ROOT . '/' . $theme_path . '/' . $relative;
    if (is_file($uri)) {
      return [
        'url' => '/' . $theme_path . '/' . $relative,
        'alt' => (string) t('Tax incentives at @project', ['@project' => $title]),
      ];
    }
  }

  return [
    'url' => '/' . $theme_path . '/images/thue.jpg',
    'alt' => (string) t('Tax incentives at @project', ['@project' => $title]),
  ];
}

/**
 * Builds existing customer logos for a projects detail page.
 *
 * @return array<int, array{url: string, alt: string}>
 */
function cassiopeia_projects_customer_logos(NodeInterface $node): array {
  foreach (['field_customer_logos', 'field_existing_customers', 'field_khach_hang'] as $field_name) {
    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }
    $logos = [];
    foreach ($node->get($field_name) as $item) {
      $image = cassiopeia_image_field_item_data($item);
      if ($image) {
        $logos[] = [
          'url' => $image['url'],
          'alt' => $image['alt'] ?: $node->label(),
        ];
      }
    }
    if ($logos !== []) {
      return $logos;
    }
  }

  $theme_path = \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');
  $base = '/' . $theme_path . '/images/customers/';
  $files = [
    'logo-1.png',
    'logo-2.png',
    'logo-3.png',
    'logo-4.png',
    'logo-5.png',
    'logo-6.png',
    'logo-7.png',
    'brand-1.png',
    'brand-2.png',
    'brand-3.png',
    'brand-4.png',
    'logo-1.png',
    'logo-2.png',
    'logo-3.png',
  ];

  $logos = [];
  foreach ($files as $index => $file) {
    $logos[] = [
      'url' => $base . $file,
      'alt' => (string) t('Customer @num', ['@num' => $index + 1]),
    ];
  }

  return $logos;
}

/**
 * Builds hero image variables for a projects node.
 *
 * @return array{hero_image: string, hero_image_alt: string}
 */
function cassiopeia_projects_hero_image(NodeInterface $node, LanguageInterface $language): array {
  $banner = cassiopeia_page_banner('projects', $node->label(), $language);
  $banner_node = cassiopeia_banner_index($language)['projects'] ?? NULL;
  if ($banner_node instanceof NodeInterface) {
    return [
      'hero_image' => $banner['hero_image'],
      'hero_image_alt' => $banner['hero_image_alt'],
    ];
  }

  if ($node->hasField('field_anh') && !$node->get('field_anh')->isEmpty()) {
    $image = cassiopeia_image_field_item_data($node->get('field_anh')->first());
    if ($image) {
      return [
        'hero_image' => $image['url'],
        'hero_image_alt' => $image['alt'] ?: $node->label(),
      ];
    }
  }

  return [
    'hero_image' => $banner['hero_image'],
    'hero_image_alt' => $banner['hero_image_alt'],
  ];
}

/**
 * Builds variables for projects detail templates.
 */
function cassiopeia_projects_detail_variables(NodeInterface $node): array {
  $language = $node->language();
  $title = $node->label();
  $theme_path = \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');
  $hero = cassiopeia_projects_hero_image($node, $language);
  $front_url = Url::fromRoute('<front>', [], ['language' => $language])->toString();
  $contact_url = cassiopeia_contact_url(['language' => $language]);

  $address = $node->hasField('field_address') && !$node->get('field_address')->isEmpty()
    ? trim((string) $node->get('field_address')->value)
    : '';

  $download_url = NULL;
  $download_label = (string) t('Download');
  if ($node->hasField('field_file') && !$node->get('field_file')->isEmpty()) {
    $file = $node->get('field_file')->entity;
    if ($file) {
      $download_url = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
      $download_label = $file->getFilename() ?: $download_label;
    }
  }

  $gallery = [];
  if ($node->hasField('field_anh') && !$node->get('field_anh')->isEmpty()) {
    foreach ($node->get('field_anh') as $item) {
      $image = cassiopeia_image_field_item_data($item);
      if ($image) {
        $gallery[] = $image + ['alt' => $image['alt'] ?: $title];
      }
    }
  }

  $specifications = [];
  if ($node->hasField('field_specifications') && !$node->get('field_specifications')->isEmpty()) {
    foreach ($node->get('field_specifications') as $item) {
      $paragraph = $item->entity;
      if (!$paragraph instanceof ParagraphInterface || $paragraph->bundle() !== 'para_specifications') {
        continue;
      }
      $label = trim((string) ($paragraph->get('field_title')->value ?? ''));
      $value = trim((string) ($paragraph->get('field_content')->value ?? ''));
      if ($label !== '' || $value !== '') {
        $specifications[] = [
          'label' => $label,
          'value' => $value,
        ];
      }
    }
  }

  $location_map = NULL;
  if ($node->hasField('field_image_location') && !$node->get('field_image_location')->isEmpty()) {
    $location_map = cassiopeia_image_field_item_data($node->get('field_image_location')->first());
    if ($location_map) {
      $location_map['alt'] = $location_map['alt'] ?: $title;
    }
  }

  $distances = [];
  if ($node->hasField('field_location') && !$node->get('field_location')->isEmpty()) {
    foreach ($node->get('field_location') as $item) {
      $paragraph = $item->entity;
      if (!$paragraph instanceof ParagraphInterface || $paragraph->bundle() !== 'vi_tri_du_an') {
        continue;
      }
      $icon = $paragraph->hasField('field_anh') && !$paragraph->get('field_anh')->isEmpty()
        ? cassiopeia_image_field_item_data($paragraph->get('field_anh')->first())
        : NULL;
      $label = trim((string) ($paragraph->get('field_title')->value ?? ''));
      $value = trim((string) ($paragraph->get('field_content')->value ?? ''));
      if ($label === '' && $value === '') {
        continue;
      }
      $distances[] = [
        'icon' => $icon,
        'label' => $label,
        'value' => $value,
      ];
    }
  }

  $zones = [];
  if ($node->hasField('field_zoning_area') && !$node->get('field_zoning_area')->isEmpty()) {
    foreach ($node->get('field_zoning_area') as $item) {
      $paragraph = $item->entity;
      if (!$paragraph instanceof ParagraphInterface || $paragraph->bundle() !== 'khu_vuc_phan_vung') {
        continue;
      }
      $map = $paragraph->hasField('field_anh') && !$paragraph->get('field_anh')->isEmpty()
        ? cassiopeia_image_field_item_data($paragraph->get('field_anh')->first())
        : NULL;
      $label = trim((string) ($paragraph->get('field_title')->value ?? ''));
      if (!$map && $label === '') {
        continue;
      }
      $zones[] = [
        'title' => $label,
        'map' => $map,
      ];
    }
  }

  $infrastructure = [];
  if ($node->hasField('field_infrastructure') && !$node->get('field_infrastructure')->isEmpty()) {
    foreach ($node->get('field_infrastructure') as $item) {
      $paragraph = $item->entity;
      if (!$paragraph instanceof ParagraphInterface) {
        continue;
      }
      $card = cassiopeia_projects_infrastructure_item($paragraph);
      if ($card) {
        $infrastructure[] = $card;
      }
    }
  }

  $map_url = $address !== ''
    ? 'https://www.google.com/maps/search/?api=1&query=' . rawurlencode($address)
    : NULL;

  return [
    'title' => $title,
    'hero_image' => $hero['hero_image'],
    'hero_image_alt' => $hero['hero_image_alt'],
    'address' => $address,
    'intro_paragraphs' => cassiopeia_projects_intro_paragraphs($node),
    'contact_url' => $contact_url,
    'total_area' => $node->hasField('field_total_area') && !$node->get('field_total_area')->isEmpty()
      ? trim((string) $node->get('field_total_area')->value)
      : '',
    'land_use' => $node->hasField('field_land_use') && !$node->get('field_land_use')->isEmpty()
      ? trim((string) $node->get('field_land_use')->value)
      : '',
    'price' => $node->hasField('field_price') && !$node->get('field_price')->isEmpty()
      ? trim((string) $node->get('field_price')->value)
      : '',
    'download_url' => $download_url,
    'download_label' => $download_label,
    'gallery' => $gallery,
    'specifications' => $specifications,
    'location_map' => $location_map,
    'map_url' => $map_url,
    'distances' => $distances,
    'zones' => $zones,
    'infrastructure' => $infrastructure,
    'tax' => [
      'benefits' => cassiopeia_projects_tax_benefits($node),
      'image' => cassiopeia_projects_tax_image($node, $title),
    ],
    'customers' => cassiopeia_projects_customer_logos($node),
    'related' => cassiopeia_projects_related($node),
    'contact_form_image' => '/' . $theme_path . '/images/banner-form.jpg',
    'location_icon' => '/' . $theme_path . '/images/svg/location-green.svg',
    'breadcrumb' => [
      [
        'label' => t('Home'),
        'url' => $front_url,
      ],
      [
        'label' => t('Projects'),
        'url' => $front_url,
      ],
      [
        'label' => $title,
        'url' => NULL,
      ],
    ],
    'labels' => [
      'total_area' => (string) t('Total area'),
      'project_name' => (string) t('Project name'),
      'land_use' => (string) t('Land use'),
      'address' => (string) t('Address'),
      'price' => (string) t('Price'),
      'document' => (string) t('Document'),
      'download' => (string) t('Download'),
      'contact_us' => (string) t('Contact us'),
      'gallery' => (string) t('Project gallery'),
      'tech_specs' => (string) t('Technical specifications'),
      'expand' => (string) t('Expand table'),
      'collapse' => (string) t('Collapse table'),
      'location' => (string) t('Location'),
      'google_map' => (string) t('Google map'),
      'zoning' => (string) t('2D zoning'),
      'infrastructure' => (string) t('Infrastructure'),
      'tax' => (string) t('Tax incentives'),
      'tax_contact' => (string) t('Contact us now'),
      'customers' => (string) t('Existing customers'),
      'contact_request' => (string) t('Contact request'),
      'contact_note' => (string) t('Note: Fields marked with (*) are required.'),
      'related' => (string) t('Other projects'),
      'see_more' => (string) t('See more'),
    ],
  ];
}

/**
 * Builds a solution card from a linh_vuc_hoat_dong or co_so_ha_tang paragraph.
 *
 * @return array{image: ?array, title: string, text: string}|null
 */
function cassiopeia_dich_vu_solution_card(ParagraphInterface $paragraph): ?array {
  if ($paragraph->bundle() === 'co_so_ha_tang') {
    $card = cassiopeia_projects_infrastructure_item($paragraph);
    if (!$card) {
      return NULL;
    }
    return [
      'image' => $card['icon'],
      'title' => $card['title'],
      'text' => implode(' ', $card['texts']),
    ];
  }

  if ($paragraph->bundle() !== 'linh_vuc_hoat_dong') {
    return NULL;
  }

  $title = trim((string) ($paragraph->get('field_title')->value ?? ''));
  $text = '';
  if ($paragraph->hasField('field_body') && !$paragraph->get('field_body')->isEmpty()) {
    $text = trim(html_entity_decode(strip_tags((string) $paragraph->get('field_body')->processed), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
  }
  $image = $paragraph->hasField('field_anh') && !$paragraph->get('field_anh')->isEmpty()
    ? cassiopeia_image_field_item_data($paragraph->get('field_anh')->first())
    : NULL;

  if ($title === '' && $text === '' && !$image) {
    return NULL;
  }

  return [
    'image' => $image,
    'title' => $title,
    'text' => $text,
  ];
}

/**
 * Builds one stat item for a service detail page.
 *
 * @return array{value: string, unit: string, label: string}|null
 */
function cassiopeia_dich_vu_stat_item(ParagraphInterface $paragraph): ?array {
  if ($paragraph->bundle() !== 'so_lieu_thong_ke') {
    return NULL;
  }

  $value = trim((string) ($paragraph->get('field_title')->value ?? ''));
  $label = trim((string) ($paragraph->get('field_content')->value ?? ''));
  $unit = trim((string) ($paragraph->get('field_unit')->value ?? ''));
  if ($value === '' && $label === '') {
    return NULL;
  }

  return [
    'value' => $value,
    'unit' => $unit,
    'label' => $label,
  ];
}

/**
 * Builds one process step for a service detail page.
 *
 * @return array{icon: ?array, title: string, description: string}|null
 */
function cassiopeia_dich_vu_process_step(ParagraphInterface $paragraph): ?array {
  if ($paragraph->bundle() !== 'buoc_quy_trinh') {
    return NULL;
  }

  $title = trim((string) ($paragraph->get('field_title')->value ?? ''));
  $description = '';
  if ($paragraph->hasField('field_body') && !$paragraph->get('field_body')->isEmpty()) {
    $description = trim(html_entity_decode(strip_tags((string) $paragraph->get('field_body')->processed), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
  }
  $icon = $paragraph->hasField('field_anh') && !$paragraph->get('field_anh')->isEmpty()
    ? cassiopeia_image_field_item_data($paragraph->get('field_anh')->first())
    : NULL;

  if ($title === '' && $description === '' && !$icon) {
    return NULL;
  }

  return [
    'icon' => $icon,
    'title' => $title,
    'description' => $description,
  ];
}

/**
 * Builds one highlight block for a service detail page.
 *
 * @return array<string, mixed>|null
 */
function cassiopeia_dich_vu_highlight_block(ParagraphInterface $paragraph): ?array {
  if ($paragraph->bundle() !== 'khoi_noi_bat') {
    return NULL;
  }

  $image = $paragraph->hasField('field_anh') && !$paragraph->get('field_anh')->isEmpty()
    ? cassiopeia_image_field_item_data($paragraph->get('field_anh')->first())
    : NULL;
  $title = trim((string) ($paragraph->get('field_title')->value ?? ''));
  $lead = '';
  if ($paragraph->hasField('field_body') && !$paragraph->get('field_body')->isEmpty()) {
    $lead = (string) $paragraph->get('field_body')->processed;
  }

  $items = [];
  if ($paragraph->hasField('field_para_para_content') && !$paragraph->get('field_para_para_content')->isEmpty()) {
    foreach ($paragraph->get('field_para_para_content') as $item) {
      $child = $item->entity;
      if (!$child instanceof ParagraphInterface || $child->bundle() !== 'muc_noi_bat') {
        continue;
      }
      $item_title = trim((string) ($child->get('field_title')->value ?? ''));
      $body = '';
      if ($child->hasField('field_body') && !$child->get('field_body')->isEmpty()) {
        $body = (string) $child->get('field_body')->processed;
      }
      $icon = $child->hasField('field_anh') && !$child->get('field_anh')->isEmpty()
        ? cassiopeia_image_field_item_data($child->get('field_anh')->first())
        : NULL;
      if ($item_title === '' && $body === '' && !$icon) {
        continue;
      }
      $items[] = [
        'icon' => $icon,
        'title' => $item_title,
        'body' => $body,
      ];
    }
  }

  if ($title === '' && $lead === '' && !$image && $items === []) {
    return NULL;
  }

  $style = 'list';
  foreach ($items as $item) {
    if ($item['title'] !== '') {
      $style = 'cards';
      break;
    }
  }

  return [
    'image' => $image,
    'title' => $title,
    'lead' => $lead,
    'items' => $items,
    'style' => $style,
  ];
}

/**
 * Builds one gallery tab for a service detail page.
 *
 * @return array{title: string, images: array<int, array{url: string, alt: string}>}|null
 */
function cassiopeia_dich_vu_gallery_tab(ParagraphInterface $paragraph): ?array {
  if ($paragraph->bundle() !== 'tab_hinh_anh') {
    return NULL;
  }

  $title = trim((string) ($paragraph->get('field_title')->value ?? ''));
  $images = [];
  if ($paragraph->hasField('field_hinh_anh') && !$paragraph->get('field_hinh_anh')->isEmpty()) {
    foreach ($paragraph->get('field_hinh_anh') as $item) {
      $image = cassiopeia_image_field_item_data($item);
      if ($image) {
        $images[] = $image + ['alt' => $image['alt'] ?: $title];
      }
    }
  }

  if ($images === []) {
    return NULL;
  }

  return [
    'title' => $title,
    'images' => $images,
  ];
}

/**
 * Builds one "why choose us" item for a service detail page.
 *
 * @return array{number: string, title: string, text: string}|null
 */
function cassiopeia_dich_vu_why_item(ParagraphInterface $paragraph): ?array {
  if ($paragraph->bundle() !== 'tai_sao_chon') {
    return NULL;
  }

  $number = trim((string) ($paragraph->get('field_content')->value ?? ''));
  $title = trim((string) ($paragraph->get('field_title')->value ?? ''));
  $text = '';
  if ($paragraph->hasField('field_body') && !$paragraph->get('field_body')->isEmpty()) {
    $text = trim(html_entity_decode(strip_tags((string) $paragraph->get('field_body')->processed), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
  }

  if ($number === '' && $title === '' && $text === '') {
    return NULL;
  }

  return [
    'number' => $number,
    'title' => $title,
    'text' => $text,
  ];
}

/**
 * Builds featured project card data for a service detail page.
 *
 * @return array<string, mixed>|null
 */
function cassiopeia_dich_vu_featured_project(NodeInterface $project): ?array {
  if ($project->bundle() !== 'projects' || !$project->isPublished()) {
    return NULL;
  }

  $teaser = cassiopeia_projects_teaser_data($project);
  $theme_path = \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');

  return $teaser + [
    'badge_icon' => '/' . $theme_path . '/images/factory-icon.svg',
    'location_icon' => '/' . $theme_path . '/images/svg/location-green.svg',
  ];
}

/**
 * Builds customer logos for a service detail page.
 *
 * @return array<int, array{url: string, alt: string, link: string}>
 */
function cassiopeia_dich_vu_customer_logos(NodeInterface $node): array {
  $language = $node->language();
  $partner_url = Url::fromUserInput('/doi-tac-khach-hang', ['language' => $language])->toString();
  $logos = [];

  if ($node->hasField('field_anh') && !$node->get('field_anh')->isEmpty()) {
    foreach ($node->get('field_anh') as $item) {
      $image = cassiopeia_image_field_item_data($item);
      if ($image) {
        $logos[] = $image + [
          'alt' => $image['alt'] ?: $node->label(),
          'link' => $partner_url,
        ];
      }
    }
  }

  if ($logos !== []) {
    return $logos;
  }

  $fallback = cassiopeia_projects_customer_logos($node);
  foreach ($fallback as &$logo) {
    $logo['link'] = $partner_url;
  }
  return $fallback;
}

/**
 * Builds hero image variables for a dich_vu node.
 *
 * @return array{hero_image: string, hero_image_alt: string}
 */
function cassiopeia_dich_vu_hero_image(NodeInterface $node, LanguageInterface $language): array {
  if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
    $image = cassiopeia_image_field_item_data($node->get('field_image')->first());
    if ($image) {
      return [
        'hero_image' => $image['url'],
        'hero_image_alt' => $image['alt'] ?: $node->label(),
      ];
    }
  }

  $banner = cassiopeia_page_banner('services', $node->label(), $language);
  return [
    'hero_image' => $banner['hero_image'],
    'hero_image_alt' => $banner['hero_image_alt'],
  ];
}

/**
 * Builds variables for dich_vu detail templates.
 */
function cassiopeia_dich_vu_detail_variables(NodeInterface $node): array {
  $language = $node->language();
  $title = $node->label();
  $theme_path = \Drupal::service('extension.list.theme')->getPath('cassiopeia_theme');
  $hero = cassiopeia_dich_vu_hero_image($node, $language);
  $front_url = Url::fromRoute('<front>', [], ['language' => $language])->toString();
  $services_url = Url::fromUserInput('/dich-vu', ['language' => $language])->toString();
  $contact_url = cassiopeia_contact_url(['language' => $language]);

  $intro_image = NULL;
  if ($node->hasField('field_intro_image') && !$node->get('field_intro_image')->isEmpty()) {
    $intro_image = cassiopeia_image_field_item_data($node->get('field_intro_image')->first());
    if ($intro_image) {
      $intro_image['alt'] = $intro_image['alt'] ?: $title;
    }
  }

  $why_image = NULL;
  if ($node->hasField('field_why_image') && !$node->get('field_why_image')->isEmpty()) {
    $why_image = cassiopeia_image_field_item_data($node->get('field_why_image')->first());
    if ($why_image) {
      $why_image['alt'] = $why_image['alt'] ?: $title;
    }
  }

  $stats = [];
  if ($node->hasField('field_so_lieu') && !$node->get('field_so_lieu')->isEmpty()) {
    foreach ($node->get('field_so_lieu') as $item) {
      $paragraph = $item->entity;
      if ($paragraph instanceof ParagraphInterface) {
        $stat = cassiopeia_dich_vu_stat_item($paragraph);
        if ($stat) {
          $stats[] = $stat;
        }
      }
    }
  }

  $highlights = [];
  if ($node->hasField('field_khoi_noi_bat') && !$node->get('field_khoi_noi_bat')->isEmpty()) {
    foreach ($node->get('field_khoi_noi_bat') as $item) {
      $paragraph = $item->entity;
      if ($paragraph instanceof ParagraphInterface) {
        $block = cassiopeia_dich_vu_highlight_block($paragraph);
        if ($block) {
          $highlights[] = $block;
        }
      }
    }
  }

  $solutions = [];
  if ($node->hasField('field_giai_phap') && !$node->get('field_giai_phap')->isEmpty()) {
    foreach ($node->get('field_giai_phap') as $item) {
      $paragraph = $item->entity;
      if ($paragraph instanceof ParagraphInterface) {
        $card = cassiopeia_dich_vu_solution_card($paragraph);
        if ($card) {
          $solutions[] = $card;
        }
      }
    }
  }

  $process = [];
  if ($node->hasField('field_quy_trinh') && !$node->get('field_quy_trinh')->isEmpty()) {
    foreach ($node->get('field_quy_trinh') as $item) {
      $paragraph = $item->entity;
      if ($paragraph instanceof ParagraphInterface) {
        $step = cassiopeia_dich_vu_process_step($paragraph);
        if ($step) {
          $process[] = $step;
        }
      }
    }
  }

  $gallery_tabs = [];
  if ($node->hasField('field_hinh_anh_tabs') && !$node->get('field_hinh_anh_tabs')->isEmpty()) {
    foreach ($node->get('field_hinh_anh_tabs') as $item) {
      $paragraph = $item->entity;
      if ($paragraph instanceof ParagraphInterface) {
        $tab = cassiopeia_dich_vu_gallery_tab($paragraph);
        if ($tab) {
          $gallery_tabs[] = $tab;
        }
      }
    }
  }

  $why_items = [];
  if ($node->hasField('field_tai_sao') && !$node->get('field_tai_sao')->isEmpty()) {
    foreach ($node->get('field_tai_sao') as $item) {
      $paragraph = $item->entity;
      if ($paragraph instanceof ParagraphInterface) {
        $why = cassiopeia_dich_vu_why_item($paragraph);
        if ($why) {
          $why_items[] = $why;
        }
      }
    }
  }

  $featured_projects = [];
  if ($node->hasField('field_du_an') && !$node->get('field_du_an')->isEmpty()) {
    foreach ($node->get('field_du_an') as $item) {
      $project = $item->entity;
      if ($project instanceof NodeInterface) {
        $card = cassiopeia_dich_vu_featured_project($project);
        if ($card) {
          $featured_projects[] = $card;
        }
      }
    }
  }

  $process_has_descriptions = FALSE;
  foreach ($process as $step) {
    if ($step['description'] !== '') {
      $process_has_descriptions = TRUE;
      break;
    }
  }

  $gallery_show_tabs = count($gallery_tabs) > 1;
  foreach ($gallery_tabs as $tab) {
    if ($tab['title'] === '') {
      $gallery_show_tabs = FALSE;
      break;
    }
  }

  $highlight_cards = [];
  $highlight_lists = [];
  foreach ($highlights as $highlight) {
    if (($highlight['style'] ?? '') === 'cards') {
      $highlight_cards[] = $highlight;
    }
    else {
      $highlight_lists[] = $highlight;
    }
  }

  return [
    'title' => $title,
    'hero_image' => $hero['hero_image'],
    'hero_image_alt' => $hero['hero_image_alt'],
    'intro_paragraphs' => cassiopeia_projects_intro_paragraphs($node),
    'intro_image' => $intro_image,
    'stats' => $stats,
    'highlight_cards' => $highlight_cards,
    'highlight_lists' => $highlight_lists,
    'solutions' => $solutions,
    'solutions_layout' => count($solutions) > 2 ? 'carousel' : 'grid',
    'process' => $process,
    'process_compact' => !$process_has_descriptions,
    'gallery_tabs' => $gallery_tabs,
    'gallery_show_tabs' => $gallery_show_tabs,
    'customers' => cassiopeia_dich_vu_customer_logos($node),
    'featured_projects' => $featured_projects,
    'why_items' => $why_items,
    'why_image' => $why_image,
    'contact_url' => $contact_url,
    'contact_form_image' => '/' . $theme_path . '/images/services/contact-panel.png',
    'process_box_image' => '/' . $theme_path . '/images/pt-box.png',
    'gallery_arrow_left' => '/' . $theme_path . '/images/svg/gallery-arrow-left.svg',
    'gallery_arrow_right' => '/' . $theme_path . '/images/svg/gallery-arrow-right.svg',
    'breadcrumb' => [
      ['label' => t('Home'), 'url' => $front_url],
      ['label' => t('Services'), 'url' => $services_url],
      ['label' => $title, 'url' => NULL],
    ],
    'labels' => [
      'contact_us' => (string) t('Contact us'),
      'solutions' => (string) t('Comprehensive solutions'),
      'fields' => (string) t('Areas of activity'),
      'process' => (string) t('Process'),
      'gallery' => (string) t('Gallery'),
      'customers' => (string) t('Our customers'),
      'featured_projects' => (string) t('Featured projects'),
      'why_choose' => (string) t('Why choose CNC Industrial?'),
      'contact_request' => (string) t('Contact request'),
      'contact_note' => (string) t('Note: Fields marked with (*) are required.'),
    ],
  ];
}

/**
 * Builds variables for partner detail templates.
 */
function cassiopeia_partner_detail_variables(NodeInterface $node): array {
  $language = $node->language();
  $title = $node->label();
  $banner = cassiopeia_page_banner('partner', $title, $language);

  $stories = [];
  if ($node->hasField('field_customer_stories') && !$node->get('field_customer_stories')->isEmpty()) {
    foreach ($node->get('field_customer_stories') as $item) {
      $paragraph = $item->entity;
      if ($paragraph instanceof ParagraphInterface && $paragraph->bundle() === 'cau_chuyen_khach_hang') {
        $stories[] = cassiopeia_partner_story_data($paragraph);
      }
    }
  }

  $video_stories = [];
  if ($node->hasField('field_customer_stories_video') && !$node->get('field_customer_stories_video')->isEmpty()) {
    foreach ($node->get('field_customer_stories_video') as $item) {
      $paragraph = $item->entity;
      if ($paragraph instanceof ParagraphInterface && $paragraph->bundle() === 'cau_chuyen_khach_hang_video') {
        $video_stories[] = cassiopeia_partner_video_story_data($paragraph);
      }
    }
  }

  return [
    'title' => $title,
    'hero_image' => $banner['hero_image'],
    'hero_image_alt' => $banner['hero_image_alt'],
    'stories_title' => (string) t('Customer stories'),
    'trusted_title' => (string) t('We are a trusted partner of customers worldwide'),
    'stories' => $stories,
    'video_stories' => $video_stories,
    'trusted_logos' => cassiopeia_partner_trusted_logos($node),
    'breadcrumb' => [
      [
        'label' => t('Home'),
        'url' => Url::fromRoute('<front>', [], ['language' => $language])->toString(),
      ],
      [
        'label' => t('About us'),
        'url' => NULL,
      ],
      [
        'label' => $title,
        'url' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function cassiopeia_preprocess_page(array &$variables): void {
  $variables['site_config'] = cassiopeia_site_config();
  $variables['#cache']['tags'][] = 'config:cassiopeia.settings';
}

/**
 * Implements hook_preprocess_HOOK() for views_view templates.
 *
 * Hides default node teasers on tx_article term pages; layout comes from news.html.twig.
 */
function cassiopeia_preprocess_views_view(array &$variables): void {
  if (!\Drupal::moduleHandler()->moduleExists('views')) {
    return;
  }

  $view = $variables['view'];
  if ($view->storage->id() !== 'taxonomy_term' || $view->current_display !== 'page_1') {
    return;
  }

  $tid = (int) ($view->args[0] ?? 0);
  if (!$tid) {
    return;
  }

  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
  if (!$term instanceof TermInterface || $term->bundle() !== 'tx_article') {
    return;
  }

  $variables['rows'] = [];
  $variables['empty'] = '';
  $variables['pager'] = [];
  $variables['feed_icons'] = [];
  $variables['more'] = '';
  $variables['footer'] = '';
}
