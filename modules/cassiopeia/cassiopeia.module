/**
 * Base entity query for published gallery nodes.
 */
function cassiopeia_gallery_node_query(): QueryInterface {
  return \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'gallery')
    ->condition('status', 1);
}

/**
 * Builds album card data for a gallery node.
 */
function cassiopeia_gallery_album_data(NodeInterface $node, $thumb_style = NULL, $full_style = NULL): array {
  $thumb_style ??= \Drupal::entityTypeManager()->getStorage('image_style')->load('wide')
    ?: \Drupal::entityTypeManager()->getStorage('image_style')->load('large');

  $images = [];
  if ($node->hasField('field_anh') && !$node->get('field_anh')->isEmpty()) {
    foreach ($node->get('field_anh') as $item) {
      $file = $item->entity;
      if ($file) {
        $uri = $file->getFileUri();
        $images[] = [
          'url' => cassiopeia_image_url($uri, $full_style),
          'alt' => (string) ($item->alt ?: $node->label()),
        ];
      }
    }
  }

  if ($images === [] && $node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
    $item = $node->get('field_image')->first();
    $file = $item?->entity;
    if ($file) {
      $uri = $file->getFileUri();
      $images[] = [
        'url' => cassiopeia_image_url($uri, $full_style),
        'alt' => (string) ($item->alt ?: $node->label()),
      ];
    }
  }

  $cover = NULL;
  if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
    $item = $node->get('field_image')->first();
    $file = $item?->entity;
    if ($file) {
      $uri = $file->getFileUri();
      $cover = [
        'url' => cassiopeia_image_url($uri, $thumb_style),
        'alt' => (string) ($item->alt ?: $node->label()),
      ];
    }
  }
  if ($cover === NULL && $images !== []) {
    $cover = [
      'url' => cassiopeia_image_url(
        $node->get('field_anh')->first()->entity->getFileUri(),
        $thumb_style,
      ),
      'alt' => $images[0]['alt'],
    ];
  }

  $group = 'gallery-' . $node->id();

  return [
    'id' => $node->id(),
    'title' => $node->label(),
    'fancybox_group' => $group,
    'cover' => $cover,
    'images' => $images,
    'count' => count($images),
  ];
}

