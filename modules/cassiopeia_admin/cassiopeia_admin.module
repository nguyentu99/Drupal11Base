<?php

use Drupal\cassiopeia_admin\Entity\AdministratorBlock;
use Drupal\cassiopeia_admin\Entity\AdministratorBlockItem;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Link;
use Drupal\Core\Url;

/**
 * Copies state admin_theme_path into admin_theme.settings when config is empty.
 */
function cassiopeia_admin_sync_admin_theme_paths(): void {
  $paths = \Drupal::state()->get('admin_theme_path');
  if (!$paths || !\Drupal::moduleHandler()->moduleExists('admin_theme')) {
    return;
  }
  $config = \Drupal::configFactory()->getEditable('admin_theme.settings');
  $existing = $config->get('paths');
  if ($existing === NULL || $existing === '') {
    $config->set('paths', $paths)->save();
  }
}

/**
 * Invalidates render cache for the administrator sidebar menu.
 */
function cassiopeia_admin_invalidate_menu_cache(): void {
  \Drupal::service('cassiopeia_admin.menu_repository')->invalidateMenuCache();
}

/**
 * Implements hook_entity_insert().
 */
function cassiopeia_admin_entity_insert(EntityInterface $entity): void {
  cassiopeia_admin_config_entity_changed($entity);
  cassiopeia_admin_entity_may_invalidate_menu($entity);
}

/**
 * Implements hook_entity_update().
 */
function cassiopeia_admin_entity_update(EntityInterface $entity): void {
  cassiopeia_admin_config_entity_changed($entity);
  cassiopeia_admin_entity_may_invalidate_menu($entity);
}

/**
 * Implements hook_entity_delete().
 */
function cassiopeia_admin_entity_delete(EntityInterface $entity): void {
  cassiopeia_admin_config_entity_changed($entity);
  cassiopeia_admin_entity_may_invalidate_menu($entity);
}

/**
 * Invalidates menu cache when administrator block config entities change.
 */
function cassiopeia_admin_config_entity_changed(EntityInterface $entity): void {
  if ($entity instanceof AdministratorBlock || $entity instanceof AdministratorBlockItem) {
    cassiopeia_admin_invalidate_menu_cache();
  }
}

/**
 * Invalidates menu cache when user or role entities change (permissions context).
 */
function cassiopeia_admin_entity_may_invalidate_menu(EntityInterface $entity): void {
  $type = $entity->getEntityTypeId();
  if ($type === 'user' || $type === 'user_role') {
    cassiopeia_admin_invalidate_menu_cache();
  }
}

/**
 * Implements hook_modules_installed().
 */
function cassiopeia_admin_modules_installed(array $modules, bool $is_sync): void {
  cassiopeia_admin_invalidate_menu_cache();
}

/**
 * Implements hook_modules_uninstalled().
 */
function cassiopeia_admin_modules_uninstalled(array $modules, bool $is_sync): void {
  cassiopeia_admin_invalidate_menu_cache();
}

function administrator_block_load($id) {
  return \Drupal::service('cassiopeia_admin.menu_repository')->loadBlock($id);
}

function administrator_block_save($block = NULL) {
  if (empty($block)) {
    return;
  }
      if (is_array($block)) {
        $block = (object) $block;
      }
  \Drupal::service('cassiopeia_admin.menu_repository')->saveBlock($block);
}

function administrator_block_position_update($id, $position) {
  \Drupal::service('cassiopeia_admin.menu_repository')->updateBlockPosition($id, $position);
}

function administrator_block_delete($id) {
  \Drupal::service('cassiopeia_admin.menu_repository')->deleteBlock($id);
}

function administrator_block_item_save($blockItem) {
  if (empty($blockItem)) {
    return;
  }
      if (is_array($blockItem)) {
        $blockItem = (object) $blockItem;
      }
  \Drupal::service('cassiopeia_admin.menu_repository')->saveItem($blockItem);
}

function administrator_block_item_delete($id, $expected_bid = NULL) {
  \Drupal::service('cassiopeia_admin.menu_repository')->deleteItem($id, $expected_bid);
}

function administrator_block_item_position_update($id, $position, $expected_bid = NULL) {
  \Drupal::service('cassiopeia_admin.menu_repository')->updateItemPosition($id, $position, $expected_bid);
}

function administrator_block_item_load($id) {
  return \Drupal::service('cassiopeia_admin.menu_repository')->loadItem($id);
}

