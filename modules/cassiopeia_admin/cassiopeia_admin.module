/**
 * Implements hook_requirements().
 */
function cassiopeia_admin_requirements(string $phase): array {
  $requirements = [];
  if ($phase === 'runtime') {
    $requirements['cassiopeia_admin_composer_audit'] = [
      'title' => t('Composer security audit'),
      'value' => t('Run after dependency updates'),
      'description' => t('From the project root, run <code>composer audit</code> and address reported advisories.'),
      'severity' => REQUIREMENT_INFO,
    ];
  }
  return $requirements;
}

/**
 * Implements hook_page_bottom().
 */
function cassiopeia_admin_page_bottom(array &$page_bottom) {
  $user = \Drupal::currentUser();
  $admin_context = \Drupal::service('router.admin_context');
  if ($admin_context->isAdminRoute() || !$user->hasPermission('cassiopeia admin content manager')) {
    return;
  }
  $page_bottom['cassiopeia_admin_menu'] = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['cassiopeia-admin-floating-link'],
    ],
    'link' => Link::fromTextAndUrl(t('Administration'), Url::fromUri('internal:/admin'))->toRenderable(),
    '#attached' => [
      'library' => ['cassiopeia_admin/floating_admin_link'],
    ],
  ];
}
