<?php

/**
 * @file
 * Cassiopeia admin module hooks and legacy procedural wrappers.
 */

use Drupal\Core\Link;
use Drupal\Core\Url;

/**
 * Returns the administrator storage service.
 */
function cassiopeia_admin_storage(): \Drupal\cassiopeia_admin\Storage\AdministratorStorage {
  return \Drupal::service('cassiopeia_admin.storage');
}

/**
 * Loads an administrator block.
 */
function administrator_block_load($id) {
  return cassiopeia_admin_storage()->loadBlock($id);
}

/**
 * Saves an administrator block.
 */
function administrator_block_save($block = NULL) {
  if (!empty($block)) {
    cassiopeia_admin_storage()->saveBlock($block);
    cassiopeia_admin_invalidate_menu_cache();
  }
}

/**
 * Updates block position.
 */
function administrator_block_position_update($id, $position) {
  cassiopeia_admin_storage()->updateBlockPosition($id, $position);
  cassiopeia_admin_invalidate_menu_cache();
}

/**
 * Deletes an administrator block and its items.
 */
function administrator_block_delete($id) {
  cassiopeia_admin_storage()->deleteBlock($id);
  cassiopeia_admin_invalidate_menu_cache();
}

/**
 * Saves an administrator block item.
 */
function administrator_block_item_save($blockItem) {
  if (!empty($blockItem)) {
    cassiopeia_admin_storage()->saveBlockItem($blockItem);
    cassiopeia_admin_invalidate_menu_cache();
  }
}

/**
 * Updates block item position.
 */
function administrator_block_item_position_update($id, $position) {
  cassiopeia_admin_storage()->updateBlockItemPosition($id, $position);
  cassiopeia_admin_invalidate_menu_cache();
}

/**
 * Loads an administrator block item.
 */
function administrator_block_item_load($id) {
  return cassiopeia_admin_storage()->loadBlockItem($id);
}

/**
 * Deletes an administrator block item.
 */
function administrator_block_item_delete($id) {
  cassiopeia_admin_storage()->deleteBlockItem($id);
  cassiopeia_admin_invalidate_menu_cache();
}

/**
 * Invalidates cached administrator menu renderings.
 */
function cassiopeia_admin_invalidate_menu_cache(): void {
  \Drupal::service('cache_tags.invalidator')->invalidateTags(['cassiopeia_admin_menu']);
}

/**
 * Implements hook_theme().
 */
function cassiopeia_admin_theme($existing, $type, $theme, $path) {
  return [
    'cassiopeia_admin_administrator_blocks_page' => [
      'variables' => [
        'cassiopeiaAdminAdministratorBlockAddForm' => NULL,
        'cassiopeiaAdminAdministratorBlocksForm' => NULL,
      ],
    ],
    'cassiopeia_admin_administrator_block_edit_page' => [
      'variables' => [
        'cassiopeiaAdminAdministratorBlockEditForm' => NULL,
      ],
    ],
    'cassiopeia_admin_administrator_block_delete_page' => [
      'variables' => [
        'cassiopeiaAdminAdministratorBlockDeleteForm' => NULL,
      ],
    ],
    'cassiopeia_admin_administrator_blocks_form' => [
      'render element' => 'form',
      'file' => 'cassiopeia_admin.theme.inc',
    ],
    'cassiopeia_admin_administrator_block_add_form' => [
      'render element' => 'form',
    ],
    'cassiopeia_admin_administrator_block_edit_form' => [
      'render element' => 'form',
    ],
    'cassiopeia_admin_administrator_block_delete_form' => [
      'render element' => 'form',
    ],
    'cassiopeia_admin_administrator_block_items_page' => [
      'variables' => [
        'cassiopeiaAdminAdministratorBlockItemAddForm' => NULL,
        'cassiopeiaAdminAdministratorBlockItemsForm' => NULL,
      ],
    ],
    'cassiopeia_admin_administrator_block_items_form' => [
      'render element' => 'form',
      'file' => 'cassiopeia_admin.theme.inc',
    ],
    'cassiopeia_admin_administrator_block_item_edit_page' => [
      'variables' => [
        'cassiopeiaAdminAdministratorBlockItemEditForm' => NULL,
      ],
    ],
    'cassiopeia_admin_administrator_block_item_edit_form' => [
      'render element' => 'form',
    ],
    'cassiopeia_admin_administrator_block_item_delete_page' => [
      'variables' => [
        'cassiopeiaAdminAdministratorBlockItemDeleteForm' => NULL,
      ],
    ],
    'cassiopeia_admin_administrator_block_item_delete_form' => [
      'render element' => 'form',
    ],
    'cassiopeia_admin_administrator_icon' => [
      'variables' => ['icon' => NULL],
      'file' => 'cassiopeia_admin.theme.inc',
    ],
    'cassiopeia_admin_administrator_menu' => [
      'variables' => ['items' => NULL],
      'file' => 'cassiopeia_admin.theme.inc',
    ],
  ];
}

/**
 * Implements hook_page_bottom().
 */
function cassiopeia_admin_page_bottom(array &$page_bottom) {
  $user = \Drupal::currentUser();
  $is_admin_route = \Drupal::service('router.admin_context')->isAdminRoute();

  if ($is_admin_route) {
    return;
  }

  $can_access = $user->hasPermission('cassiopeia admin content')
    || $user->hasPermission('cassiopeia admin content manager')
    || $user->hasPermission('c3s quantri access theme');

  if (!$can_access) {
    return;
  }

  $destination = $user->hasPermission('cassiopeia admin content')
    || $user->hasPermission('cassiopeia admin content manager')
    ? 'admin'
    : 'manager';

  $page_bottom['cassiopeia_admin_menu'] = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['cassiopeia-admin-floating-link'],
      'role' => 'navigation',
      'aria-label' => t('Administration shortcut'),
    ],
    '#attached' => [
      'library' => ['cassiopeia_admin/floating-admin-link'],
    ],
    'link' => [
      '#type' => 'link',
      '#title' => t('Quản trị'),
      '#url' => Url::fromUserInput('/' . $destination),
    ],
  ];
}
