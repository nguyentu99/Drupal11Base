<?php

function cassiopeia_admin_install() {
  $path[] = 'administrator';
  $path[] = 'admin';
  $path[] = 'admin/*';
  $path[] = 'manager';
  $path[] = 'manager/*';
  $path[] = 'user';
  $path[] = 'user/*';
  \Drupal::state()->set('admin_theme_path', implode("\n", $path));
  cassiopeia_admin_sync_admin_theme_paths();
  cassiopeia_admin_install_entity_types();
  cassiopeia_admin_install_image_style();
}

/**
 * Creates the avatar image style used by cassiopeia_admin_theme.
 */
function cassiopeia_admin_install_image_style(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('image_style');
  if ($storage->load('style_200x200')) {
    return;
  }
  /** @var \Drupal\image\Entity\ImageStyle $style */
  $style = $storage->create([
    'name' => 'style_200x200',
    'label' => '200x200',
  ]);
  $style->addImageEffect([
    'id' => 'image_scale_and_crop',
    'data' => [
      'width' => 200,
      'height' => 200,
      'anchor' => 'center-center',
    ],
  ]);
  $style->save();
}

/**
 * Registers config entity types on first module install.
 */
function cassiopeia_admin_install_entity_types(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();
  foreach (['administrator_block', 'administrator_block_item'] as $entity_type_id) {
    if ($manager->getEntityType($entity_type_id) === NULL) {
      $manager->installEntityType($entity_type_manager->getDefinition($entity_type_id));
    }
  }
}

/**
 * Implements hook_schema().
 *
 * Legacy SQL tables were removed in favor of config entities (see update 11003).
 */
function cassiopeia_admin_schema() {
  return [];
}

/**
 * Adds url_meta column and backfills route metadata for menu items.
 */
function cassiopeia_admin_update_11001(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('administrator_block_items', 'url_meta')) {
    $schema->addField('administrator_block_items', 'url_meta', [
      'type' => 'text',
      'size' => 'big',
      'not null' => FALSE,
    ]);
  }
  if (!$schema->indexExists('administrator_block_items', 'bid')) {
    $schema->addIndex('administrator_block_items', 'bid', ['bid']);
  }

  $items = \Drupal::database()->select('administrator_block_items', 'i')
    ->fields('i', ['id', 'link'])
    ->execute();
  foreach ($items as $item) {
    \Drupal::database()->update('administrator_block_items')
      ->fields([
        'url_meta' => \Drupal\cassiopeia_admin\Service\AdministratorLinkMetadata::encodeStorage($item->link),
      ])
      ->condition('id', $item->id)
      ->execute();
  }

  cassiopeia_admin_invalidate_menu_cache();
}

/**
 * Syncs admin theme paths from state into admin_theme module config.
 */
function cassiopeia_admin_update_11002(): void {
  cassiopeia_admin_sync_admin_theme_paths();
}

/**
 * Migrates administrator blocks/items from SQL tables to config entities.
 */
function cassiopeia_admin_update_11003(): string {
  $connection = \Drupal::database();
  $schema = $connection->schema();
  if (!$schema->tableExists('administrator_blocks')) {
    return (string) t('Legacy tables not found; skipping migration.');
  }

  $block_storage = \Drupal::entityTypeManager()->getStorage('administrator_block');
  $item_storage = \Drupal::entityTypeManager()->getStorage('administrator_block_item');

  $blocks = $connection->select('administrator_blocks', 'b')
    ->fields('b')
    ->execute()
    ->fetchAll();
  foreach ($blocks as $row) {
    if (!$block_storage->load((string) $row->id)) {
      $block_storage->create([
        'id' => (string) $row->id,
        'name' => $row->name,
        'icon' => $row->icon,
        'position' => (float) $row->position,
      ])->save();
    }
  }

  $items = $connection->select('administrator_block_items', 'i')
    ->fields('i')
    ->execute()
    ->fetchAll();
  foreach ($items as $row) {
    if (!$item_storage->load((string) $row->id)) {
      $item_storage->create([
        'id' => (string) $row->id,
        'block_id' => (string) $row->bid,
        'name' => $row->name,
        'link' => $row->link,
        'icon' => $row->icon,
        'position' => (float) $row->position,
        'url_meta' => $row->url_meta ?? NULL,
      ])->save();
    }
  }

  \Drupal::state()->set('cassiopeia_admin.legacy_migrated', TRUE);
  cassiopeia_admin_invalidate_menu_cache();

  return (string) t('Migrated @blocks administrator blocks and @items menu items to configuration.', [
    '@blocks' => count($blocks),
    '@items' => count($items),
  ]);
}

/**
 * Drops legacy SQL tables after config migration.
 */
function cassiopeia_admin_update_11004(): void {
  $schema = \Drupal::database()->schema();
  foreach (['administrator_block_items', 'administrator_blocks'] as $table) {
    if ($schema->tableExists($table)) {
      $schema->dropTable($table);
    }
  }
}

/**
 * Registers administrator_block config entity types (fixes status report).
 */
function cassiopeia_admin_update_11005(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();
  foreach (['administrator_block', 'administrator_block_item'] as $entity_type_id) {
    if ($manager->getEntityType($entity_type_id) === NULL) {
      $manager->installEntityType($entity_type_manager->getDefinition($entity_type_id));
    }
  }
}

/**
 * Creates style_200x200 image style for admin avatars (P-12).
 */
function cassiopeia_admin_update_11006(): void {
  cassiopeia_admin_install_image_style();
}

/**
 * Implementation of hook_uninstall()
 */
function cassiopeia_admin_uninstall() {
  \Drupal::state()->delete('admin_theme_path');
  \Drupal::state()->delete('cassiopeia_admin.legacy_migrated');
  $schema = \Drupal::database()->schema();
  foreach (['administrator_block_items', 'administrator_blocks'] as $table) {
    if ($schema->tableExists($table)) {
      $schema->dropTable($table);
    }
  }
}
