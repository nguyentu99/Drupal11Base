{#
/**
 * @file
 * Cassiopeia administration dashboard.
 *
 * Available variables:
 * - welcome_title: Dashboard heading.
 * - welcome_message: Short intro text.
 * - stats: Stat widgets for the top row.
 * - link_groups: Grouped quick links from the sidebar menu.
 */
#}
<div class="cassiopeia-admin-dashboard">
  <div class="mb-4">
    <h4 class="mb-1">{{ welcome_title }}</h4>
    <p class="text-muted mb-0">{{ welcome_message }}</p>
  </div>

  {% if stats %}
    <div class="row">
      {% for stat in stats %}
        <div class="col-lg-3 col-md-6 col-12 mb-3">
          <div class="small-box text-bg-{{ stat.color }}">
            <div class="inner">
              <h3>{{ stat.value }}</h3>
              <p>{{ stat.label }}</p>
            </div>
            <div class="small-box-icon">
              <i class="bi {{ stat.icon }}"></i>
            </div>
            {% if stat.url %}
              <a href="{{ stat.url }}" class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover">
                {{ 'More info'|t }} <i class="bi bi-arrow-right-circle"></i>
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
