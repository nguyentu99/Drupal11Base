<ul class="nav sidebar-menu nav-legacy flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
  <li class="nav-header">{{ 'Main navigation'|t }}</li>
  {% for block in blocks %}
    <li class="nav-item{{ block.open ? ' menu-open' : '' }}">
      <a href="#" class="nav-link{{ block.open ? ' active' : '' }}">
        {% if block.icon_class %}
          <i class="{{ block.icon_class }}"></i>
        {% endif %}
        <p>{{ block.label }} <i class="nav-arrow bi bi-chevron-right"></i></p>
      </a>
      {% if block.links is not empty %}
        <ul class="nav nav-treeview">
          {% for link in block.links %}
            <li class="nav-item">{{ link }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
