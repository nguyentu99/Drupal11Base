<ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
  {% for block in items %}
    {% if "active" in block['#attributes']['class'] %}
      {% set class %} menu-open {% endset %}
    {% else %}
      {% set class %}  {% endset %}
    {% endif %}
    <li class="nav-item {{ class }}">
      <a href="#"  {{ attributes.addClass(block['#attributes']['class']) }}>{{ block['#title'] | raw }}</a>
      <ul class="nav nav-treeview">
        {% for item in block['#below'] %}
          <li class="nav-item">
              {% set link_text %}{{ item['#title']|raw }}{% endset %}
              {{ link(link_text, item['#url'], create_attribute(item['#attributes'])) }}
          </li>
        {% endfor %}
      </ul>
    </li>
  {% endfor %}
</ul> <!--end::Sidebar Menu-->


