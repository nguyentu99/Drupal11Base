<ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
  {% for block in items %}
    {% set block_classes = block['#attributes']['class']|default([]) %}
    <li class="nav-item{{ 'menu-open' in block_classes ? ' menu-open' : '' }}">
      <a href="{{ block['#href']|default('#') }}" class="{{ block_classes|join(' ') }}">{{ block['#title']|raw }}</a>
      {% if block['#below'] is not empty %}
        <ul class="nav nav-treeview">
          {% for item in block['#below'] %}
            <li class="nav-item">
              {% set link_text %}{{ item['#title']|raw }}{% endset %}
              {{ link(link_text, item['#url'], create_attribute(item['#attributes']|default({}))) }}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
